      },
      {
        "type": "file",
        "value": "BRAND.md"
      },
      {
        "type": "file",
        "value": "README.md"
      },
      {
        "type": "file",
        "value": "V2-DEPLOY.md"
      },
      {
        "type": "file",
        "value": "database-migrate.cmd"
      },
      {
        "type": "file",
        "value": "database-migrate.ps1"
      },
      {
        "type": "file",
        "value": "database-preflight.cmd"
      },
      {
        "type": "file",
        "value": "database-preflight.ps1"
      },
      {
        "type": "file",
        "value": "setup-local.cmd"
      },
      {
        "type": "file",
        "value": "setup-local.ps1"
      },
      {
        "type": "file",
        "value": "update-main-force.cmd"
      },
      {
        "type": "file",
        "value": "update-main.cmd"
      },
      {
        "type": "file",
        "value": "update-main.ps1"
      },
      {
        "type": "file",
        "value": "v2-migrate-legacy.cmd"
      },
      {
        "type": "file",
        "value": "v2-migrate-legacy.ps1"
      }
