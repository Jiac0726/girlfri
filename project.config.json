{
  "miniprogramRoot": "./",
  "cloudfunctionRoot": "cloudfunctions/",
  "compileType": "miniprogram",
  "appid": "wxYOUR_APPID",
  "projectname": "renian",
  "description": "热念 · 双人每日关系记录小程序",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "docs"
