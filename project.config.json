      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "folder",
        "value": "scripts"
      },
      {
        "type": "folder",
        "value": ".github"
      },
      {
        "type": "folder",
        "value": ".playwright-cli"
      },
      {
        "type": "folder",
        "value": "output"
      },
      {
        "type": "folder",
        "value": "backups"
      },
      {
        "type": "file",
        "value": "config/env.local.example.js"
      },
      {
        "type": "file",
        "value": "project.private.config.example.json"
      },
      {
        "type": "file",
        "value": "cloudbaserc.release.json"
      },
      {
        "type": "file",
