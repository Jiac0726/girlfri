.agreement-page { padding-bottom: 100rpx; }
.page-intro { padding: 20rpx 8rpx 36rpx; }
.intro-title { color: #49323c; font-size: 44rpx; font-weight: 700; margin-top: 12rpx; }
.intro-copy, .editor-note { color: #826772; font-size: 25rpx; line-height: 1.75; margin-top: 14rpx; }
.editor-note { margin-bottom: 20rpx; padding: 18rpx; background: #fff3f5; border-radius: 16rpx; }
.preset-row, .actions { display: flex; flex-wrap: wrap; gap: 14rpx; }
.preset-row { margin-bottom: 22rpx; }
.preset-chip { margin: 0; padding: 10rpx 18rpx; font-size: 22rpx; line-height: 1.6; color: #974259; background: #fff0f3; border-radius: 20rpx; }
button::after { border: none; }
.field { width: 100%; box-sizing: border-box; height: 88rpx; padding: 20rpx 22rpx; background: #fff8fa; border: 1px solid #ecd6de; border-radius: 18rpx; font-size: 27rpx; color: #49323c; }
.content-field { height: auto; min-height: 160rpx; margin-top: 18rpx; line-height: 1.7; }
.input-count { font-size: 21rpx; text-align: right; color: #927680; margin: 8rpx 0 20rpx; }
.actions { margin-top: 22rpx; }
.primary-btn, .secondary-btn, .quiet-btn { flex: 1; min-width: 180rpx; margin: 0; padding: 18rpx 22rpx; border-radius: 22rpx; line-height: 1.5; font-size: 25rpx; }
.primary-btn { background: #a94c63; color: #fff; }
.secondary-btn { background: #faedf1; color: #99485e; }
.quiet-btn { background: #f4f0f1; color: #79636c; }
button[disabled] { opacity: .5; }
.section-title { font-size: 30rpx; font-weight: 700; margin: 38rpx 8rpx 20rpx; color: #49323c; }
.agreement-card { padding: 28rpx; margin-bottom: 18rpx; border-radius: 24rpx; background: #fff; border: 1px solid #eddbe1; }
.status-pending { border-color: #e6c2b1; background: #fffcf8; }
.item-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; color: #866873; font-size: 22rpx; }
.status-badge { background: #f5eaf0; color: #86556a; padding: 5rpx 14rpx; border-radius: 18rpx; }
.status-badge.active { background: #edf3ed; color: #59765d; }
.item-title { font-size: 30rpx; color: #49323c; font-weight: 700; margin-top: 20rpx; word-break: break-all; }
.item-content { margin-top: 10rpx; font-size: 26rpx; line-height: 1.8; white-space: pre-wrap; word-break: break-all; color: #6c525e; }
.item-date { color: #947e87; font-size: 21rpx; margin-top: 18rpx; }
.revision-note { font-size: 23rpx; color: #9c7053; margin-top: 18rpx; }
.history-card { background: #fffafc; }
.empty-state, .loading-note { padding: 26rpx 12rpx; font-size: 25rpx; line-height: 1.7; text-align: center; color: #927781; }
.notice { margin-bottom: 26rpx; padding: 26rpx; background: #fff3e8; border-radius: 22rpx; color: #805e4e; font-size: 25rpx; }
.notice button { margin-top: 20rpx; }
.load-more { margin-top: 24rpx; }
.footnote { text-align: center; color: #8f747e; }
