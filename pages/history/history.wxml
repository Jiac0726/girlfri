<view class="container">
  <!-- 汇总 -->
  <view class="summary card">
    <view class="sum-item">
      <view class="sum-num sum-good">{{goodCount}}</view>
      <view class="sum-label">👍 好评</view>
    </view>
    <view class="sum-divider"></view>
    <view class="sum-item">
      <view class="sum-num sum-bad">{{badCount}}</view>
      <view class="sum-label">👎 差评</view>
    </view>
    <view class="sum-divider"></view>
    <view class="sum-item">
      <view class="sum-num">{{totalCount}}</view>
      <view class="sum-label">总评价</view>
    </view>
  </view>

  <!-- 记录列表 -->
  <view class="card" wx:if="{{list.length}}">
    <view class="card-title">全部记录</view>
    <view
      class="record {{index === list.length - 1 ? 'record-last' : ''}}"
      wx:for="{{list}}"
      wx:key="key"
    >
      <view class="record-badge {{item.type === 'good' ? 'badge-good' : 'badge-bad'}}">
        {{item.type === 'good' ? '👍' : '👎'}}
      </view>
      <view class="record-body">
        <view class="record-top">
          <view class="record-date">{{item.date}}</view>
          <view class="record-week">{{item.weekDay}}</view>
          <view class="direction-tag {{item.fromMe ? 'direction-mine' : 'direction-partner'}}">
            {{item.directionLabel}}
          </view>
          <view class="record-tag {{item.type === 'good' ? 'tag-good' : 'tag-bad'}}">
            {{item.type === 'good' ? '好评' : '差评'}}
          </view>
        </view>
        <view class="record-reason" wx:if="{{item.reason}}">{{item.reason}}</view>
        <view class="record-reason record-reason-empty" wx:else>没写原因～</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    还没有任何记录 ✨<br />
    去「今日评价」给 TA 留下第一条吧
  </view>
</view>
