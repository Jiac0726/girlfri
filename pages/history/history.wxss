/* 汇总条 */
.summary {
  display: flex;
  align-items: center;
  padding: 40rpx 20rpx;
}

.sum-item {
  flex: 1;
  text-align: center;
}
.sum-num {
  font-size: 60rpx;
  font-weight: 700;
  color: #4a3540;
  line-height: 1.1;
}
.sum-good {
  color: #ff6b81;
}
.sum-bad {
  color: #90a4ae;
}
.sum-label {
  font-size: 24rpx;
  color: #b08090;
  margin-top: 10rpx;
}
.sum-divider {
  width: 1rpx;
  height: 60rpx;
  background: #f2dfe5;
}

/* 记录 */
.record {
  display: flex;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #faeef1;
}
.record-last {
  border-bottom: none;
}

.record-badge {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  margin-right: 22rpx;
}
.badge-good {
  background: #ffe3e8;
}
.badge-bad {
  background: #eceff1;
}

.record-body {
  flex: 1;
  min-width: 0;
}

.record-top {
  display: flex;
  align-items: center;
}
.record-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #4a3540;
}
.record-week {
  font-size: 22rpx;
  color: #c0a8b0;
  margin-left: 14rpx;
}
.record-tag {
  margin-left: 10rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.tag-good {
  color: #ff6b81;
  background: #ffe3e8;
}
.tag-bad {
  color: #78909c;
  background: #eceff1;
}

.record-reason {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b5560;
  line-height: 1.7;
  word-break: break-all;
}
.record-reason-empty {
  color: #d8c0c8;
}


.direction-tag {
  margin-left: auto;
  font-size: 19rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.direction-mine {
  color: #ff6b81;
  background: #fff0f3;
}

.direction-partner {
  color: #7b6a72;
  background: #f5eef1;
}

.direction-tag + .record-tag {
  margin-left: 10rpx;
}
