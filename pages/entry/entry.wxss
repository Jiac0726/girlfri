@import "../index/index.wxss";

.entry-page{padding-bottom:96rpx}
.editor{width:100%;box-sizing:border-box;margin-top:30rpx;background:#fffbfc;border:1rpx solid #f1dfe4;border-radius:var(--card-radius);padding:0 var(--card-pad);overflow:hidden}
.entry-section{padding:30rpx 0;border-bottom:1rpx solid #f2e5e9}
.entry-section:last-of-type{border-bottom:0}
.section-head{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;margin-bottom:18rpx}
.section-title{font-size:28rpx;line-height:1.4;font-weight:700;color:#533d48}
.section-hint{flex-shrink:0;font-size:21rpx;color:#aa8d98}

.ratings{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx}
.rating{display:flex;align-items:center;justify-content:center;min-width:0;height:76rpx;box-sizing:border-box;border:1rpx solid #f0dfe4;border-radius:20rpx;background:#faf1f4;color:#7d6570;font-size:25rpx;font-weight:600}
.rating.selected{border-color:#c85a7d;box-shadow:inset 0 0 0 1rpx #c85a7d}
.rating.selected.good{background:#f9e2e7;color:#a8455e}
.rating.selected.neutral{background:#f3eee9;color:#7f6d63}
.rating.selected.bad{background:#eee9ed;color:#6f6069}

.moods{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12rpx}
.mood{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;height:116rpx;box-sizing:border-box;padding:12rpx 6rpx;border:1rpx solid #f1e3e7;border-radius:20rpx;background:#fbf4f6}
.mood.selected{border-color:#cf6b88;background:#f8e4ea;box-shadow:inset 0 0 0 1rpx #cf6b88}
.mood-emoji{font-size:38rpx;line-height:1.15}
.mood-label{max-width:100%;margin-top:8rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#876f79;font-size:19rpx;line-height:1.3}
.mood.selected .mood-label{color:#a74662;font-weight:600}

.text-box{box-sizing:border-box;padding:20rpx 22rpx 12rpx;border:1rpx solid #f0dfe4;border-radius:20rpx;background:#fff8fa}
.entry-textarea{display:block;width:100%;min-height:220rpx;box-sizing:border-box;padding:0;background:transparent;color:#513b45;font-size:28rpx;line-height:1.75}
.counter{text-align:right;margin-top:8rpx;color:#ad929c;font-size:20rpx}

.photos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin-bottom:16rpx}
.photo{position:relative;height:174rpx;overflow:hidden;border-radius:18rpx;background:#f7ecef}
.photo image{display:block;width:100%;height:100%}
.photo button{position:absolute;top:8rpx;right:8rpx;width:46rpx;height:46rpx;margin:0;padding:0;border-radius:50%;background:rgba(62,43,51,.72);color:#fff;font-size:27rpx;line-height:46rpx}
.photo button::after{border:0}
.add-photo-button{display:flex;align-items:center;justify-content:center;width:100%;height:82rpx;margin:0;box-sizing:border-box;border:1rpx dashed #ddb8c4;border-radius:20rpx;background:#fff7f9;color:#ad4968;font-size:24rpx;line-height:82rpx}
.add-photo-button::after{border:0}
.add-photo-button[disabled]{background:#faf4f6;color:#c6adb5}
.add-photo-plus{margin-right:8rpx;font-size:30rpx}

.share-button{width:100%;margin:30rpx 0 0}
.publish-note{padding:18rpx 0 28rpx;text-align:center;color:#ad929c;font-size:21rpx;line-height:1.6}
.error-panel{margin-top:24rpx}
