@import "../index/index.wxss";
.editor{width:100%;box-sizing:border-box;margin-top:32rpx;background:#fffbfc;border-radius:var(--card-radius);padding:var(--card-pad)}.editor textarea{width:100%;min-height:260rpx;font-size:29rpx;line-height:1.8}.counter{text-align:right;font-size:22rpx;color:#a18a94}.photos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin-top:24rpx}.photo{position:relative;height:170rpx}.photo image{width:100%;height:100%;border-radius:16rpx}.photo button{position:absolute;right:0;top:0;border-radius:50%;font-size:28rpx;line-height:48rpx;width:48rpx;padding:0;background:#704b5ccc;color:white}.moods{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:20rpx}.mood{width:23%;margin:0;padding:14rpx 4rpx;font-size:40rpx;background:#f9f0f3;line-height:1.5}.mood text{display:block;font-size:21rpx;color:#977d88}.mood.selected{background:#f6d6e2;box-shadow:inset 0 0 0 2rpx #c85a7d}.error-panel{margin-top:24rpx}

.rating-title{margin-top:28rpx}
.ratings{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin-top:16rpx}
.rating{margin:0;padding:16rpx 8rpx;border-radius:20rpx;background:#f9f0f3;color:#7f6570;font-size:24rpx;line-height:1.5}
.rating.selected{box-shadow:inset 0 0 0 2rpx #c85a7d;font-weight:600}
.rating.selected.good{background:#f9e2e7;color:#a8455e}
.rating.selected.neutral{background:#f3eee9;color:#7f6d63}
.rating.selected.bad{background:#eee9ed;color:#6f6069}
