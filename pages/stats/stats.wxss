/* 好评率 */
.rate-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 36rpx 44rpx;
}

.ring-wrap {
  position: relative;
  width: 320rpx;
  height: 320rpx;
}
.ring-canvas {
  width: 320rpx;
  height: 320rpx;
}
.ring-center {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ring-num {
  font-size: 84rpx;
  font-weight: 700;
  color: #ff6b81;
  line-height: 1;
  letter-spacing: -2rpx;
}
.ring-pct {
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 4rpx;
}
.ring-label {
  font-size: 24rpx;
  color: #b08090;
  margin-top: 14rpx;
}

.verdict {
  margin-top: 34rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #4a3540;
  background: #fff0f3;
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
}

/* KPI */
.kpi-card {
  display: flex;
  padding: 40rpx 10rpx;
}
.kpi {
  flex: 1;
  text-align: center;
}
.kpi-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #4a3540;
  line-height: 1.1;
}
.kpi-label {
  font-size: 22rpx;
  color: #b08090;
  margin-top: 10rpx;
}

/* 最近 14 天 */
.days {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.day-cell {
  width: calc((100% - 84rpx) / 7);
  height: 108rpx;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #faf3f5;
}
.day-emoji {
  font-size: 34rpx;
  line-height: 1.2;
}
.day-num {
  font-size: 20rpx;
  color: #c0a8b0;
  margin-top: 4rpx;
}

.cell-good {
  background: #ffe3e8;
}
.cell-good .day-num {
  color: #ff6b81;
}
.cell-bad {
  background: #eceff1;
}
.cell-bad .day-emoji {
  font-size: 30rpx;
}
.cell-bad .day-num {
  color: #78909c;
}
.cell-none .day-emoji {
  color: #d8c0c8;
  font-size: 26rpx;
}
.cell-today {
  box-shadow: inset 0 0 0 3rpx #ff6b81;
}

.legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 28rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #b08090;
}
.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}
.dot-good {
  background: #ffe3e8;
}
.dot-bad {
  background: #eceff1;
}
.dot-none {
  background: #faf3f5;
}

/* 本月 */
.month-bar {
  display: flex;
  height: 28rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #faf3f5;
}
.month-good {
  background: #ff6b81;
  transition: width 0.3s ease;
}
.month-bad {
  background: #cfd8dc;
  transition: width 0.3s ease;
}
.month-legend {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
}
.month-legend-item {
  font-size: 24rpx;
}

.footnote {
  text-align: center;
  color: #d8c0c8;
  font-size: 22rpx;
  margin-top: 20rpx;
}

/* 导出图片 */
.poster-btn {
  margin-top: 34rpx;
  background: #ffffff !important;
  color: #ff6b81 !important;
  border: 3rpx solid #ff6b81;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 96rpx;
  line-height: 96rpx;
}
.poster-btn::after {
  border: none;
}

/* 离屏画布：不能用 display:none，否则取不到 node */
.poster-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 750px;
  height: 1200px;
}


.cell-partial {
  background: #fff7f9;
}

.cell-mixed {
  background: #fff3d8;
}

.cell-mixed .day-num {
  color: #9c7a35;
}

.cell-mixed .day-emoji,
.cell-partial .day-emoji {
  font-size: 27rpx;
}
