<view class="container">
  <!-- 好评率 -->
  <view class="card rate-card">
    <view class="ring-wrap">
      <canvas type="2d" id="ring" class="ring-canvas"></canvas>
      <view class="ring-center">
        <view class="ring-num">
          {{goodRate}}<text class="ring-pct">%</text>
        </view>
        <view class="ring-label">双方好评率</view>
      </view>
    </view>
    <view class="verdict">{{verdict}}</view>
  </view>

  <!-- 关键数字 -->
  <view class="card kpi-card">
    <view class="kpi">
      <view class="kpi-num text-good">{{goodStreak}}</view>
      <view class="kpi-label">双方连续好评</view>
    </view>
    <view class="kpi">
      <view class="kpi-num">{{bestStreak}}</view>
      <view class="kpi-label">历史最长纪录</view>
    </view>
    <view class="kpi">
      <view class="kpi-num">{{totalCount}}</view>
      <view class="kpi-label">累计评价</view>
    </view>
  </view>

  <!-- 最近 14 天 -->
  <view class="card">
    <view class="card-title">最近 14 天 · 左我右 TA</view>
    <view class="days">
      <view
        class="day-cell {{item.cls}} {{item.isToday ? 'cell-today' : ''}}"
        wx:for="{{recent14}}"
        wx:key="date"
      >
        <view class="day-emoji">{{item.emoji}}</view>
        <view class="day-num">{{item.dayNum}}</view>
      </view>
    </view>
    <view class="legend">
      <view class="legend-item">
        <view class="dot dot-good"></view>好评
      </view>
      <view class="legend-item">
        <view class="dot dot-bad"></view>差评
      </view>
      <view class="legend-item">
        <view class="dot dot-none"></view>未记录
      </view>
    </view>
  </view>

  <!-- 本月 -->
  <view class="card">
    <view class="card-title">{{monthName}}</view>
    <view class="month-bar">
      <view class="month-good" style="width: {{monthGoodPct}}%"></view>
      <view class="month-bad" style="width: {{monthBadPct}}%"></view>
    </view>
    <view class="month-legend">
      <view class="month-legend-item text-good">👍 好评 {{monthGood}} 条</view>
      <view class="month-legend-item text-bad">👎 差评 {{monthBad}} 条</view>
    </view>
  </view>

  <view class="footnote">热念 · 把每天的相处认真留住 💕</view>

  <!-- 导出图片成绩单 -->
  <button class="poster-btn" bindtap="makePoster">📷 生成热念成绩单</button>

  <!-- 离屏画布，仅供出图 -->
  <canvas type="2d" id="poster" class="poster-canvas"></canvas>
</view>
