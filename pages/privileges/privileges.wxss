.privilege-page {
  padding-bottom: 90rpx;
}

.privilege-hero {
  padding: 18rpx 10rpx 34rpx;
}

.privilege-eyebrow {
  color: #ff6b81;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.privilege-title {
  margin-top: 10rpx;
  color: #4a3540;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.4;
}

.privilege-sub {
  margin-top: 12rpx;
  color: #a68591;
  font-size: 24rpx;
  line-height: 1.75;
}

.preset-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.preset-chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #fff0f3;
  color: #ff6b81;
  font-size: 23rpx;
  border: 2rpx solid #ffd7df;
}

.card-input,
.card-note {
  width: 100%;
  box-sizing: border-box;
  background: #fffafb;
  border: 2rpx solid #f3dfe5;
  border-radius: 20rpx;
  color: #4a3540;
  font-size: 28rpx;
}

.card-input {
  height: 88rpx;
  padding: 0 24rpx;
}

.card-note {
  min-height: 126rpx;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  line-height: 1.65;
}

.issue-btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #ff6b81 !important;
  color: #ffffff !important;
  font-size: 27rpx;
  font-weight: 700;
}

.issue-btn[disabled] {
  background: #f1dfe4 !important;
  color: #bda5ad !important;
}

.issue-btn::after,
.use-btn::after {
  border: none;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 38rpx 8rpx 18rpx;
}

.sent-head,
.history-head {
  margin-top: 52rpx;
}

.section-title {
  color: #4a3540;
  font-size: 30rpx;
  font-weight: 800;
}

.section-sub {
  color: #b596a2;
  font-size: 22rpx;
  margin-top: 3rpx;
}

.section-count {
  min-width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #ffe3e8;
  color: #ff6b81;
  font-size: 23rpx;
  font-weight: 700;
}

.ticket {
  position: relative;
  margin-bottom: 20rpx;
  padding: 28rpx 30rpx 26rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 2rpx solid #ffdce3;
  box-shadow: 0 7rpx 24rpx rgba(255, 107, 129, 0.09);
  overflow: hidden;
}

.ticket-received {
  background: linear-gradient(135deg, #ffffff, #fff3f6);
}

.ticket-sent {
  background: linear-gradient(135deg, #fffdfd, #fff8f0);
  border-color: #f4dfc7;
}

.ticket-edge {
  position: absolute;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  margin-top: -12rpx;
  border-radius: 50%;
  background: #fff0f3;
}

.ticket-edge-left {
  left: -12rpx;
}

.ticket-edge-right {
  right: -12rpx;
}

.ticket-top,
.ticket-foot,
.history-top {
  display: flex;
  align-items: center;
}

.ticket-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #ff6b81;
  background: #ffe7ec;
  font-size: 20rpx;
  font-weight: 700;
}

.sent-badge {
  color: #b67c37;
  background: #fff0da;
}

.ticket-status {
  margin-left: auto;
  color: #a98a96;
  font-size: 21rpx;
}

.ticket-name {
  margin-top: 20rpx;
  color: #4a3540;
  font-size: 34rpx;
  font-weight: 800;
}

.ticket-note,
.ticket-note-empty {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.65;
}

.ticket-note {
  color: #806872;
}

.ticket-note-empty {
  color: #c5afb7;
}

.ticket-foot {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed #f0dfe5;
}

.ticket-time {
  flex: 1;
  color: #b7a0a9;
  font-size: 20rpx;
}

.use-btn {
  min-width: 132rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #ff6b81 !important;
  color: #ffffff !important;
  font-size: 23rpx;
  font-weight: 700;
}

.revoke-action {
  padding: 10rpx 8rpx 10rpx 24rpx;
  color: #a07f8b;
  font-size: 23rpx;
  font-weight: 700;
}

.history-row {
  display: flex;
  margin-bottom: 16rpx;
  padding: 24rpx 26rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.78);
}

.history-icon {
  width: 54rpx;
  font-size: 30rpx;
  flex-shrink: 0;
}

.history-body {
  flex: 1;
  min-width: 0;
}

.history-name {
  flex: 1;
  color: #4a3540;
  font-size: 26rpx;
  font-weight: 800;
}

.history-status {
  margin-left: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 700;
}

.history-used {
  color: #ff6b81;
  background: #ffe6eb;
}

.history-revoked {
  color: #8c7b81;
  background: #eee9eb;
}

.history-meta {
  margin-top: 5rpx;
  color: #b096a0;
  font-size: 20rpx;
}

.history-note {
  margin-top: 8rpx;
  color: #866d76;
  font-size: 22rpx;
  line-height: 1.6;
}

.privilege-empty {
  padding: 48rpx 20rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 24rpx;
}

.privilege-footnote {
  margin: 42rpx 18rpx 0;
  color: #bca4ad;
  font-size: 21rpx;
  line-height: 1.7;
  text-align: center;
}
