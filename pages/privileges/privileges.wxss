@import "../index/index.wxss";
.gift{margin-top:32rpx}.gift input{font-size:29rpx;padding:20rpx 0}.gift textarea{width:100%;font-size:25rpx;height:160rpx;line-height:1.8;margin-top:12rpx}.coupon-heading{font-size:30rpx;font-weight:600;display:flex;align-items:center;justify-content:space-between;gap:16rpx}.status{font-size:21rpx;font-weight:400;color:#a45671}.entry-actions{flex-wrap:wrap}.history-panel{position:fixed;inset:0;background:#38233366;z-index:20;display:flex;align-items:flex-end}.history-card{width:100%;box-sizing:border-box;padding:32rpx;border-radius:32rpx 32rpx 0 0;background:#fff8fb;padding-bottom:calc(32rpx + env(safe-area-inset-bottom))}.history-scroll{max-height:60vh}.history-row{padding:24rpx 0;border-bottom:1rpx solid #efdce5}
