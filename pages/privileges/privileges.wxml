<view class="journal-page">
  <view class="page-title">给 TA 一点小偏爱</view><view class="page-sub">自由赠送，申请后由赠送方确认兑现</view>
  <view class="entry-card gift" wx:if="{{!bindingRequired}}">
    <input value="{{title}}" maxlength="40" placeholder="例如：一顿我来做的晚餐" bindinput="onTitle" disabled="{{saving || uncertain}}" />
    <textarea value="{{note}}" maxlength="200" placeholder="写下使用时的小约定（可选）" bindinput="onNote" disabled="{{saving || uncertain}}" />
    <button class="primary-button" bindtap="gift" disabled="{{saving || busyId}}" loading="{{saving}}">{{uncertain ? '重试确认' : '赠送给 TA'}}</button>
  </view>
  <view wx:if="{{error}}" class="error-panel">{{error}}<button class="text-button" bindtap="load">刷新列表</button></view>
  <button wx:if="{{bindingRequired}}" class="primary-button" bindtap="goBind">去绑定</button>
  <view wx:for="{{items}}" wx:key="id" class="entry-card">
    <view class="coupon-heading"><text>{{item.title}}</text><text class="status">{{item.statusLabel}}</text></view>
    <view class="page-sub">{{item.fromMe ? '我送给 TA 的' : 'TA 送给我的'}} · {{item.createdLabel}}</view>
    <text class="entry-text" wx:if="{{item.note}}">{{item.note}}</text>
    <view class="entry-actions">
      <button wx:if="{{item.receivedByMe && item.status === 'available'}}" class="text-button" data-id="{{item.id}}" data-action="request" bindtap="act" disabled="{{busyId || saving}}">申请兑现</button>
      <button wx:if="{{item.fromMe && item.status === 'available'}}" class="text-button" data-id="{{item.id}}" data-action="revoke" bindtap="act" disabled="{{busyId || saving}}">撤回</button>
      <button wx:if="{{item.receivedByMe && item.status === 'requested'}}" class="text-button" data-id="{{item.id}}" data-action="cancel" bindtap="act" disabled="{{busyId || saving}}">撤销申请</button>
      <block wx:if="{{item.fromMe && item.status === 'requested'}}"><button class="text-button" data-id="{{item.id}}" data-action="accept" bindtap="act" disabled="{{busyId || saving}}">确认兑现</button><button class="text-button" data-id="{{item.id}}" data-action="reject" bindtap="act" disabled="{{busyId || saving}}">暂不同意</button></block>
      <button class="text-button muted" data-id="{{item.id}}" bindtap="showHistory">记录</button>
    </view>
  </view>
  <view wx:if="{{loading}}" class="state-panel">加载中…</view><view wx:if="{{!loading && !items.length && !error}}" class="state-panel">还没有心意券，送一份小期待吧。</view>
  <button wx:if="{{nextCursor}}" class="text-button" bindtap="loadMore" disabled="{{loading}}">查看更多</button>
  <view wx:if="{{historyId}}" class="history-panel"><view class="history-card"><view class="coupon-heading">兑现记录<button class="text-button" bindtap="closeHistory">关闭</button></view>
    <scroll-view scroll-y class="history-scroll"><view wx:for="{{history}}" wx:key="id" class="history-row">{{item.statusLabel}}<view class="page-sub">{{item.createdLabel}}</view></view>
    <view wx:if="{{!history.length && !historyLoading && !historyError}}" class="state-panel">还没有申请记录</view>
    <view wx:if="{{historyError}}" class="error-panel">{{historyError}}<button class="text-button" bindtap="loadHistory">重试</button></view>
    <button wx:if="{{historyCursor}}" class="text-button" bindtap="moreHistory" disabled="{{historyLoading}}">更多记录</button><view wx:if="{{historyLoading}}" class="state-panel">加载中…</view></scroll-view>
  </view></view>
</view>
