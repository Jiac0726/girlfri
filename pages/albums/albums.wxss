page{background:#fff4f2;color:#44343d}
.album-page{padding:36rpx 30rpx calc(50rpx + env(safe-area-inset-bottom));min-height:100vh;box-sizing:border-box;background:radial-gradient(ellipse at top right,#f9dce5,transparent 60%)}
.album-heading{margin:12rpx 0 40rpx}.album-heading>view{font-size:46rpx;font-weight:600;margin:14rpx 0;overflow-wrap:anywhere}.album-heading>text{font-size:24rpx;color:#967983}.album-heading .eyebrow{font-size:18rpx;letter-spacing:4rpx;color:#bd7384}
.album-intro{display:flex;align-items:center;gap:26rpx;padding:28rpx;background:#fffaf8;border-radius:28rpx;margin-bottom:26rpx;font-size:28rpx}.album-intro>text{font-size:70rpx;color:#f17b92}.album-intro view text{display:block;font-size:22rpx;color:#a08791;line-height:1.7;margin-top:12rpx}
button.album-primary{width:100%;margin:0;padding:18rpx 22rpx;border-radius:50rpx;background:linear-gradient(110deg,#ff8b9b,#ef6280);color:#fff;font-size:27rpx;line-height:1.6;box-sizing:border-box}button::after{border:0}button[disabled]{opacity:.5}
.album-editor{padding:24rpx;background:#fffafa;border:1rpx solid #f2d7df;border-radius:28rpx;margin:24rpx 0}.album-editor input{width:100%;box-sizing:border-box;height:86rpx;padding:0 22rpx;border:0;border-radius:20rpx;background:#fff1f2;font-size:26rpx}.album-editor>text{display:block;font-size:21rpx;color:#a18892;margin:18rpx 0}
.album-grid,.photo-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx;margin-top:30rpx}.album-cover{padding:14rpx 14rpx 24rpx;border-radius:24rpx;background:#fffafa;overflow:hidden}.cover-art{height:240rpx;background:linear-gradient(145deg,#f9dae4,#faebd9);border-radius:16rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#d4778d}.cover-art>text{font-size:82rpx;line-height:1.2}.cover-art>view{font-size:22rpx;letter-spacing:3rpx}.cover-title{font-size:28rpx;font-weight:500;margin:20rpx 6rpx 8rpx;overflow-wrap:anywhere}.cover-count{font-size:22rpx;color:#a38b92;margin-left:6rpx}
.album-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:24rpx;color:#997f89}.album-toolbar button.album-primary{width:auto;margin:0;font-size:24rpx;padding:14rpx 24rpx;flex-shrink:0}
.selected-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx}.selected-grid>view{position:relative}.selected-grid image{width:100%;height:160rpx;border-radius:14rpx}.selected-grid button{position:absolute;right:0;top:0;width:44rpx;height:44rpx;line-height:44rpx;padding:0;margin:0;border-radius:50%;background:#694652cc;color:#fff;font-size:32rpx}
.photo-tile{background:#fffafa;border-radius:22rpx;overflow:hidden}.photo-tile>image{display:block;width:100%;height:300rpx}.photo-footer{display:flex;align-items:center;justify-content:space-between;padding:12rpx 16rpx;gap:6rpx;font-size:21rpx;color:#a0818d}.photo-actions{display:flex;align-items:center;gap:8rpx}.photo-footer button{width:auto;margin:0;padding:6rpx 10rpx;font-size:21rpx;line-height:1.6;background:transparent;color:#bb6b7e}.photo-placeholder{height:300rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#f7e7e9;color:#c29aa7;font-size:70rpx}.photo-placeholder text{font-size:22rpx}
.album-state{text-align:center;padding:70rpx 20rpx;color:#a48a94;font-size:27rpx;line-height:1.8}.album-state>text{display:block;font-size:23rpx;margin-top:14rpx}.album-state button{margin-top:24rpx}.album-error{padding:24rpx;margin:22rpx 0;background:#fff9f5;border:1rpx solid #efd0d6;border-radius:24rpx;color:#ab6578;font-size:25rpx;line-height:1.6}button.album-link{width:100%;padding:16rpx;margin:12rpx 0;background:transparent;color:#b7687d;font-size:25rpx;line-height:1.6}

.comment-panel{padding:16rpx;border-top:1rpx solid #f3e4e8;background:#fffdfc}.comment-loading,.comment-empty,.comment-error{padding:10rpx 4rpx;color:#a08791;font-size:21rpx;line-height:1.6}.comment-error{color:#b45f73}.comment-list{display:flex;flex-direction:column;gap:10rpx;margin-bottom:14rpx}.comment-row{display:flex;align-items:flex-start;gap:10rpx;font-size:22rpx;line-height:1.55}.comment-author{flex-shrink:0;color:#b65f78;font-weight:600}.comment-text{color:#5b4650;overflow-wrap:anywhere}.comment-compose{display:flex;align-items:center;gap:10rpx}.comment-compose input{flex:1;min-width:0;height:64rpx;padding:0 16rpx;border-radius:16rpx;background:#fff3f5;font-size:22rpx;color:#513b45}.comment-compose button{width:auto;min-width:92rpx;margin:0;padding:10rpx 18rpx;border-radius:18rpx;background:#f7d7df;color:#a74964;font-size:22rpx;line-height:1.6}
