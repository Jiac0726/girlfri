@import "../index/index.wxss";
.review-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:26rpx}
.review-head .page-title{margin:0}.review-kicker{font-size:22rpx;color:#a47a85}
.calendar{padding:0 2rpx 16rpx}
.calendar-nav{display:flex;align-items:center;justify-content:space-evenly;margin-bottom:24rpx}
.calendar-nav button{margin:0;padding:0;width:80rpx;line-height:70rpx;background:transparent;color:#52414c;font-size:46rpx}
.calendar-nav button[disabled]{opacity:.4}
.month-picker{font-size:29rpx;font-weight:500;padding:14rpx 20rpx}
.month-picker text{font-size:21rpx;margin-left:12rpx;color:#a5848d}
.calendar-week,.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));text-align:center}
.calendar-week{font-size:22rpx;color:#8e7b84;margin-bottom:12rpx}
.calendar-cell{height:92rpx;display:flex;align-items:center;justify-content:center}
button.calendar-day{display:flex;flex-direction:column;align-items:center;justify-content:center;width:74rpx;height:80rpx;box-sizing:border-box;margin:0;padding:6rpx 0 0;border-radius:50%;background:transparent;color:#3c3341;font-size:26rpx;line-height:1.2}
.day-marker{height:24rpx;font-size:24rpx;line-height:24rpx;color:#c6aaa9}.day-marker.shared{color:#fa6380;font-size:20rpx}.day-marker.recorded{font-size:30rpx}
button.calendar-day.is-today{border:1rpx solid #efbdc5}button.calendar-day.selected{color:#fff;background:linear-gradient(140deg,#ff9caa,#f65976);box-shadow:0 6rpx 14rpx #ed6b832e;border-color:transparent}
button.calendar-day.selected .day-marker{color:#fff}
.calendar-legend{display:flex;justify-content:center;flex-wrap:wrap;gap:24rpx;margin-top:22rpx;font-size:20rpx;color:#95848b}
.legend-heart{color:#f86880}.legend-dot{color:#c0a6a6;font-size:16rpx}
.month-story{position:relative;overflow:hidden;min-height:310rpx;margin:28rpx 0 32rpx;background:#f7d9da;border-radius:32rpx}
.month-story-image{position:absolute;width:100%;height:100%;opacity:.75}
.month-story-shade{position:absolute;inset:0;background:linear-gradient(180deg,#f7e1e21a 0%,#ffe6e780 45%,#fff6f4 100%)}
.month-story-title{position:relative;padding:24rpx 28rpx 10rpx;text-align:right;color:#553746}
.month-story-title>text{position:absolute;left:28rpx;top:14rpx;font-family:Georgia,serif;font-size:56rpx;color:#fffbf3c9;letter-spacing:4rpx}
.month-story-title>view{position:relative;margin-top:44rpx;font-size:36rpx;font-family:"KaiTi","STKaiti",serif}
.stats{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:52rpx;padding:22rpx 18rpx 26rpx}
.stat{text-align:center;font-size:21rpx;color:#77616b}.stat>text{display:block;color:#4a3344;font-size:38rpx;font-weight:500}.stat-unit{font-size:20rpx;font-weight:400}
.review-list-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin:26rpx 4rpx 22rpx}
.review-list-title{font-size:31rpx;font-weight:600}.review-list-sub{margin-top:6rpx;color:#9e858f;font-size:21rpx}
button.clear-day{width:auto;flex-shrink:0;margin:0;padding:10rpx 22rpx;border-radius:40rpx;background:#fff8f5;color:#c65e78;font-size:23rpx;line-height:1.6;border:1rpx solid #efd5dc}
.review-page .entry-card{border-radius:32rpx}
.review-empty{padding:32rpx;background:#fffbf9b3;border-radius:36rpx;color:#67515f}
.review-empty image{display:block;width:180rpx;height:110rpx;mix-blend-mode:multiply;margin:8rpx auto 24rpx}
.review-empty text{display:block;font-size:23rpx;color:#a18b94;margin-top:10rpx}
.review-more .text-button{margin:0 auto}
