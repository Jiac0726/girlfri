page{background:#fff6f7;color:#17283a}.review-page{min-height:100vh;padding:30rpx 34rpx 150rpx;box-sizing:border-box;position:relative;overflow:hidden}.review-bg{position:fixed;inset:0;width:100%;height:100%;opacity:.22;z-index:0;pointer-events:none}.review-page:after{content:"";position:fixed;inset:0;background:linear-gradient(180deg,rgba(255,249,250,.88),rgba(255,243,246,.96));z-index:1;pointer-events:none}.review-head{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center}.review-title{font-size:48rpx;font-weight:800}.profile-dot{width:68rpx;height:68rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#fff;color:#ef5a72;font-size:42rpx;box-shadow:0 8rpx 22rpx rgba(197,99,118,.13)}.segmented{position:relative;z-index:2;margin:26rpx 0 28rpx;padding:6rpx;display:flex;border-radius:30rpx;background:rgba(242,224,228,.7)}.segmented view{flex:1;text-align:center;padding:14rpx 0;border-radius:24rpx;color:#8b7e83;font-size:25rpx}.segmented .active{background:#fff;color:#df5369;font-weight:700;box-shadow:0 5rpx 16rpx rgba(194,113,127,.12)}.month-nav{position:relative;z-index:2;display:flex;align-items:center;justify-content:center;gap:34rpx;margin:10rpx 0 22rpx}.nav-btn{width:58rpx;height:58rpx;border-radius:50%;background:#fff1f4;color:#ed5069;display:flex;align-items:center;justify-content:center;font-size:44rpx}.nav-btn.off{opacity:.25}.month-label{font-size:32rpx;font-weight:700}.calendar-card,.day-card,.month-report{position:relative;z-index:2;background:rgba(255,255,255,.84);border:1px solid rgba(243,206,214,.7);border-radius:38rpx;box-shadow:0 18rpx 55rpx rgba(181,104,119,.08)}.calendar-card{padding:30rpx 22rpx}.week-row,.cal-grid{display:grid;grid-template-columns:repeat(7,1fr)}.week-row view{text-align:center;color:#737d87;font-size:23rpx;padding:6rpx 0 16rpx}.cal-cell{height:86rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:28rpx;position:relative}.cal-cell.selected{background:linear-gradient(135deg,#ff6d83,#f54261);color:#fff}.day-num{font-size:26rpx;line-height:1}.day-mark{font-size:22rpx;line-height:1;margin-top:8rpx}.day-mark.heart,.legend .heart{color:#f34f68}.cal-cell.selected .day-mark{color:#fff}.day-mark.neutral,.legend .neutral{color:#f3aab6}.day-mark.bad{color:#87909a}.legend{display:flex;justify-content:center;gap:30rpx;border-top:1px solid #f2dfe3;margin-top:18rpx;padding-top:22rpx;color:#7b8188;font-size:21rpx}.legend .none{color:#c8c9cc}.day-card{margin-top:22rpx;padding:32rpx}.day-title{font-size:34rpx;font-weight:800;margin-bottom:14rpx}.record{display:flex;gap:18rpx;padding:22rpx 0;border-top:1px solid #f3e0e4}.record:first-of-type{border-top:none}.record-avatar{width:66rpx;height:66rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:22rpx;flex-shrink:0}.record-avatar.mine{background:#7d8c9b}.record-avatar.partner{background:#e88395}.record-body{flex:1}.record-top{display:flex;gap:18rpx;align-items:center;font-size:25rpx;font-weight:700}.rating{font-size:22rpx}.rating.good{color:#ef4c65}.rating.neutral{color:#b77e31}.rating.bad{color:#687581}.record-text{font-size:25rpx;color:#4d5965;line-height:1.7;margin-top:8rpx}.empty-day{text-align:center;color:#9b9296;padding:50rpx 0}.month-story-btn{height:92rpx;border-radius:46rpx;margin-top:24rpx;background:linear-gradient(90deg,#ff7589,#f13f5e);color:#fff;font-size:28rpx;line-height:92rpx}.month-story-btn::after,.love-btn::after{border:none}.month-hero{position:relative;z-index:2;height:500rpx;border-radius:38rpx;overflow:hidden;position:relative;box-shadow:0 20rpx 60rpx rgba(184,102,116,.16)}.month-hero image{width:100%;height:100%}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(75,32,42,.03),rgba(63,29,38,.34))}.hero-copy{position:absolute;left:34rpx;right:34rpx;bottom:38rpx;color:#fff}.hero-en{font-size:24rpx;letter-spacing:12rpx;opacity:.85}.hero-title{font-size:56rpx;font-weight:800;margin-top:10rpx}.hero-sub{font-size:25rpx;line-height:1.6;margin-top:8rpx}.month-report{margin-top:-34rpx;position:relative;padding:42rpx 30rpx 34rpx}.report-title{font-size:38rpx;font-weight:800}.report-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:26rpx}.report-grid>view{padding:24rpx 20rpx;border-radius:26rpx;background:#fff6f8}.report-grid text{display:block;font-size:22rpx;color:#6e7882}.report-grid strong{font-size:46rpx;color:#ef4762;margin-right:6rpx}.report-grid em{font-style:normal;font-size:22rpx;color:#ef4762}.keyword-box{margin-top:22rpx;border-radius:30rpx;padding:28rpx;background:linear-gradient(135deg,#fff3f6,#ffe9ee)}.keyword-label{font-size:24rpx}.keyword{font-size:48rpx;color:#ee4963;font-weight:800;margin-top:8rpx}.keyword-bubbles{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:16rpx}.keyword-bubbles text{padding:8rpx 16rpx;background:rgba(255,255,255,.74);border-radius:18rpx;color:#c96879;font-size:20rpx}.month-quote{margin-top:22rpx;border:1px solid #f2cfd6;border-radius:28rpx;padding:28rpx;font-size:28rpx;line-height:1.75;color:#334657;background:rgba(255,255,255,.58)}.love-btn{height:96rpx;margin-top:24rpx;border:none;border-radius:48rpx;background:linear-gradient(90deg,#ff7487,#f13e5c);color:#fff;font-size:29rpx;line-height:96rpx;font-weight:600}