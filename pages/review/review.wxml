<import src="../index/entry-card.wxml" />
<view class="journal-page review-page">
  <view class="review-head">
    <view>
      <view class="eyebrow">热念 · 回顾</view>
      <view class="page-title">一起走过的日子</view>
      <view class="page-sub">按月份翻看我们的记录</view>
    </view>
    <picker mode="date" fields="month" value="{{month}}" bindchange="changeMonth">
      <view class="month-picker">{{monthLabel}}⌄</view>
    </picker>
  </view>

  <view wx:if="{{bindingStatus === 'active'}}">
    <view class="stats">
      <view class="stat"><text>{{totalEntries}}</text><view>日常</view></view>
      <view class="stat"><text>{{recordDays}}</text><view>记录天数</view></view>
      <view class="stat"><text>{{sharedDays}}</text><view>双方分享</view></view>
    </view>

    <scroll-view class="days-scroll" scroll-x enable-flex wx:if="{{days.length}}">
      <view class="days">
        <button
          wx:for="{{days}}"
          wx:key="date"
          class="day {{selectedDay === item.date ? 'selected' : ''}}"
          data-day="{{item.date}}"
          bindtap="chooseDay"
        >
          <text>{{item.dayLabel}}</text>
          <view>{{item.count}}条</view>
        </button>
      </view>
    </scroll-view>

    <view class="review-list-head">
      <view>
        <view class="review-list-title">{{selectedDayLabel || monthLabel + '日常'}}</view>
        <view class="review-list-sub">{{selectedDay ? '再点一次日期回到整月' : totalEntries + ' 条记录'}}</view>
      </view>
      <button class="clear-day" wx:if="{{selectedDay}}" bindtap="clearDay">整月</button>
    </view>

    <view class="state-panel compact" wx:if="{{loading && !entries.length}}">正在整理回忆…</view>
    <template wx:for="{{entries}}" wx:key="id" is="entry-card" data="{{entry:item,busyEntryId:busyEntryId,locked:loading}}" />

    <view class="state-panel review-empty" wx:if="{{!loading && !entries.length && !error}}">
      这段日子还没有记录，慢慢来。
    </view>

    <view class="review-more" wx:if="{{hasMore}}">
      <button class="text-button" bindtap="loadMore" disabled="{{loadingMore || loading}}">
        {{loadingMore ? '加载中…' : '查看更多'}}
      </button>
    </view>
  </view>

  <view class="state-panel" wx:elif="{{!loading}}">
    绑定后，回忆会在这里慢慢积攒。
    <button class="primary-button" bindtap="goBind">去绑定</button>
  </view>

  <view class="state-panel" wx:if="{{loading && bindingStatus !== 'active'}}">加载中…</view>
  <view class="error-panel" wx:if="{{error}}">
    {{error}}
    <button class="text-button" bindtap="refresh">重试</button>
  </view>
</view>
