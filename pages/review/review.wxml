<view class="review-page">
  <image class="review-bg" src="/assets/review-blush.jpg" mode="aspectFill"></image>

  <view class="review-head">
    <view class="review-title">回顾</view>
    <view class="profile-dot" bindtap="goProfile">♡</view>
  </view>

  <view class="segmented">
    <view class="{{reviewMode === 'calendar' ? 'active' : ''}}" bindtap="showCalendar">月历</view>
    <view class="{{reviewMode === 'month' ? 'active' : ''}}" bindtap="showMonth">月度回顾</view>
  </view>

  <block wx:if="{{reviewMode === 'calendar'}}">
    <view class="month-nav">
      <view class="nav-btn {{canPrev ? '' : 'off'}}" bindtap="prevMonth">‹</view>
      <view class="month-label">{{monthLabel}}</view>
      <view class="nav-btn {{canNext ? '' : 'off'}}" bindtap="nextMonth">›</view>
    </view>

    <view class="calendar-card">
      <view class="week-row">
        <view wx:for="{{weeks}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="cal-grid">
        <view wx:for="{{calendar}}" wx:key="key" data-key="{{item.key}}" bindtap="selectDay"
          class="cal-cell {{item.empty ? 'empty' : ''}} {{item.key === selectedDate ? 'selected' : ''}}">
          <text class="day-num">{{item.empty ? '' : item.dayNum}}</text>
          <text wx:if="{{item.mutualGood}}" class="day-mark heart">♥</text>
          <text wx:elif="{{item.hasRecord}}" class="day-mark {{item.hasBad ? 'bad' : (item.hasNeutral ? 'neutral' : 'dot')}}">•</text>
        </view>
      </view>
      <view class="legend">
        <view><text class="heart">♥</text> 双向很好</view>
        <view><text class="neutral">•</text> 有记录</view>
        <view><text class="none">○</text> 未记录</view>
      </view>
    </view>

    <view class="day-card">
      <view class="day-title">{{selectedDateLabel || '选择一天'}}</view>
      <block wx:if="{{selectedRecords.length}}">
        <view class="record" wx:for="{{selectedRecords}}" wx:key="key">
          <view class="record-avatar {{item.fromMe ? 'mine' : 'partner'}}">{{item.fromMe ? '我' : 'TA'}}</view>
          <view class="record-body">
            <view class="record-top">
              <text>{{item.fromMe ? '我' : 'TA'}}</text>
              <text class="rating {{item.type}}">{{item.type === 'good' ? '♥ 很好' : (item.type === 'neutral' ? '● 还好' : '☁ 有点糟')}}</text>
            </view>
            <view class="record-text">{{item.reason || '这一天留下了一条记录。'}}</view>
          </view>
        </view>
      </block>
      <view class="empty-day" wx:else>这一天还没有留下记录 ♡</view>
    </view>

    <button class="month-story-btn" bindtap="showMonth">查看这个月的回顾 →</button>
  </block>

  <block wx:if="{{reviewMode === 'month'}}">
    <view class="month-hero">
      <image src="/assets/hero-sunset.jpg" mode="aspectFill"></image>
      <view class="hero-shade"></view>
      <view class="hero-copy">
        <view class="hero-en">{{monthEn}}</view>
        <view class="hero-title">我们的{{month}}月 ♡</view>
        <view class="hero-sub">平凡的日子里，因为有你，变得闪闪发光。</view>
      </view>
    </view>

    <view class="month-report">
      <view class="report-title">{{month}}月的我们</view>
      <view class="report-grid">
        <view><text>一起记录</text><strong>{{monthRecordDays}}</strong><em>天</em></view>
        <view><text>彼此好评</text><strong>{{monthMutualGoodDays}}</strong><em>天</em></view>
        <view><text>好评率</text><strong>{{monthGoodRate}}</strong><em>%</em></view>
        <view><text>最长连续好评</text><strong>{{monthBestStreak}}</strong><em>天</em></view>
      </view>

      <view class="keyword-box">
        <view class="keyword-label">这个月最常出现：</view>
        <view class="keyword">「{{monthKeyword}}」</view>
        <view class="keyword-bubbles"><text>一起吃饭</text><text>散步</text><text>聊天</text></view>
      </view>

      <view class="month-quote">{{monthQuote}}</view>
      <button class="love-btn" bindtap="showCalendar">查看这个月的故事 →</button>
    </view>
  </block>
</view>