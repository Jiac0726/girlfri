<import src="../index/entry-card.wxml" />
<view class="journal-page">
  <view class="page-title">一起走过的日子</view><view class="page-sub">回头看看，那些值得留下的小事</view>
  <picker mode="date" fields="month" value="{{month}}" bindchange="changeMonth"><view class="month-picker">{{month}} ▾</view></picker>
  <view wx:if="{{bindingStatus === 'active'}}">
    <view class="stats"><view><text>{{totalEntries}}</text>条日常</view><view><text>{{recordDays}}</text>天有记录</view><view><text>{{sharedDays}}</text>天双方分享</view></view>
    <view class="days"><button wx:for="{{days}}" wx:key="date" class="day {{selectedDay === item.date ? 'selected' : ''}}" data-day="{{item.date}}" bindtap="chooseDay">{{item.date}} · {{item.count}} 条</button></view>
    <view class="feed-heading">{{selectedDay || '本月日常'}}<text class="feed-note" wx:if="{{selectedDay}}">再点日期可查看整月</text></view>
    <template wx:for="{{entries}}" wx:key="id" is="entry-card" data="{{entry:item,busyEntryId:busyEntryId,locked:loading}}" />
    <view class="state-panel" wx:if="{{!loading && !entries.length && !error}}">这段日子还没有记录，慢慢来。</view>
    <button class="text-button" wx:if="{{hasMore}}" bindtap="loadMore" disabled="{{loadingMore || loading}}">{{loadingMore ? '加载中…' : '查看更多'}}</button>
  </view>
  <view class="state-panel" wx:elif="{{!loading}}">绑定后，回忆会在这里慢慢积攒。<button class="primary-button" bindtap="goBind">去绑定</button></view>
  <view class="state-panel" wx:if="{{loading}}">加载中…</view>
  <view class="error-panel" wx:if="{{error}}">{{error}}<button class="text-button" bindtap="refresh">重试</button></view>
</view>
