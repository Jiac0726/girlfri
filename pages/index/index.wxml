<view class="journal-page">
  <view class="journal-head">
    <view>
      <view class="eyebrow">热念 · 两个人的日常</view>
      <view class="page-title">把这一刻，留给我们</view>
      <view class="page-sub">{{dateLabel}} · 想说的时候，就记下来。</view>
    </view>
    <button class="profile-link" bindtap="goProfile" aria-label="打开我们">♡</button>
  </view>

  <view class="state-panel" wx:if="{{authLoading}}">
    <view class="state-symbol">♡</view>
    <view>正在翻开我们的日常…</view>
  </view>

  <view class="state-panel" wx:elif="{{bindingStatus !== 'active' && !error}}">
    <view class="state-symbol">♡</view>
    <view class="state-title">{{bindingStatus === 'waiting' ? '等 TA 一起加入' : '先和 TA 建立双人关系'}}</view>
    <view class="state-copy">把照片、心情和小事，留在两个人的空间里。</view>
    <button class="primary-button" bindtap="goBind">{{bindingStatus === 'waiting' ? '查看邀请' : '和 TA 绑定'}}</button>
  </view>

  <block wx:else>
    <view class="error-panel" wx:if="{{error}}">
      <text>{{error}}</text>
      <button class="text-button" bindtap="retry" disabled="{{loading}}">重新加载</button>
    </view>

    <block wx:if="{{bindingStatus === 'active'}}">
      <button class="compose-prompt" bindtap="writeEntry" disabled="{{loading}}">
        <view class="compose-plus">＋</view>
        <view class="compose-copy">
          <view>记下一刻</view>
          <text>评价、心情、文字或照片，都可以留下</text>
        </view>
        <text class="compose-arrow">›</text>
      </button>

      <view class="feed-heading">
        <text>我们的日常</text>
        <text class="feed-note">先看概览，点进去再展开</text>
      </view>

      <view class="daily-overview" bindtap="goDailyFeed" aria-role="button">
        <view class="overview-top">
          <view>
            <view class="overview-kicker">{{monthLabel}}概览</view>
            <view class="overview-title">{{todayEntries ? '今天已经留下 ' + todayEntries + ' 条' : '今天还没有记录'}}</view>
          </view>
          <view class="overview-arrow">›</view>
        </view>

        <view class="overview-stats">
          <view class="overview-stat">
            <text>{{totalEntries}}</text>
            <view>本月日常</view>
          </view>
          <view class="overview-stat">
            <text>{{recordDays}}</text>
            <view>记录天数</view>
          </view>
          <view class="overview-stat">
            <text>{{sharedDays}}</text>
            <view>双方分享</view>
          </view>
        </view>

        <view class="overview-foot">
          <text>{{totalEntries ? '打开查看全部日常' : '从第一条日常开始'}}</text>
          <text>查看 ›</text>
        </view>
      </view>
    </block>
  </block>
</view>
