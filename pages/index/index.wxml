<view class="container">
  <!-- 热念品牌区 -->
  <view class="brand-hero">
    <view class="brand-mark">
      <view class="brand-heart">♥</view>
      <view class="brand-spark"></view>
    </view>
    <view class="brand-copy">
      <view class="brand-name">热念</view>
      <view class="brand-tagline">把每天的喜欢和在意，好好记下来</view>
    </view>
  </view>

  <!-- 日期头 -->
  <view class="date-header">
    <view class="date-day">{{dayNum}}</view>
    <view class="date-meta">
      <view class="date-ym">{{yearMonth}}</view>
      <view class="date-week">{{weekDay}}</view>
    </view>
    <view class="date-tip {{submitted ? 'date-tip-done' : ''}}">
      {{bindingStatus !== 'active' ? '未绑定' : (submitted ? '✓ 已评价' : '待评价')}}
    </view>
  </view>

  <view
    class="bind-banner"
    wx:if="{{!authLoading && bindingStatus !== 'active'}}"
    bindtap="goBind"
  >
    <view class="bind-banner-icon">💕</view>
    <view class="bind-banner-body">
      <view class="bind-banner-title">
        {{bindingStatus === 'waiting' ? '等待另一位加入' : '先完成双人绑定'}}
      </view>
      <view class="bind-banner-sub">
        {{bindingStatus === 'waiting' ? '打开绑定页复制绑定码或刷新状态' : '绑定后两个人共享记录，只有评价方可以写入'}}
      </view>
    </view>
    <view class="bind-banner-arrow">›</view>
  </view>

  <view class="viewer-banner" wx:if="{{bindingStatus === 'active' && !canRate}}">
    <view class="viewer-title">👀 你是{{roleLabel}}</view>
    <view class="viewer-sub">今天的评价由对方填写，你可以随时查看记录、月报和成绩单。</view>
  </view>

  <!-- 好评 / 差评 -->
  <view class="card">
    <view class="card-title">今天的相处感受</view>
    <view class="choice-row">
      <view
        class="choice {{type === 'good' ? 'choice-good-active' : ''}} {{canRate ? '' : 'choice-disabled'}}"
        bindtap="selectGood"
      >
        <view class="choice-emoji">👍</view>
        <view class="choice-label">好评</view>
        <view class="choice-sub">今天很棒</view>
      </view>
      <view
        class="choice {{type === 'bad' ? 'choice-bad-active' : ''}} {{canRate ? '' : 'choice-disabled'}}"
        bindtap="selectBad"
      >
        <view class="choice-emoji">👎</view>
        <view class="choice-label">差评</view>
        <view class="choice-sub">有待改进</view>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="card">
    <view class="card-title">
      具体原因 <text class="optional">（选填）</text>
    </view>
    <textarea
      class="reason-input {{canRate ? '' : 'reason-input-disabled'}}"
      placeholder="今天有什么值得记住的事？开心、委屈、感谢或小情绪，都可以写下来～"
      placeholder-class="reason-ph"
      value="{{reason}}"
      bindinput="onReasonInput"
      maxlength="200"
      disabled="{{!canRate}}"
      auto-height
    />
    <view class="reason-count">{{reason.length}}/200</view>
  </view>

  <!-- 提交 -->
  <button
    wx:if="{{canRate}}"
    class="submit-btn {{type ? '' : 'submit-btn-disabled'}}"
    bindtap="submit"
    disabled="{{!type || loading}}"
  >
    {{submitted ? '更新今天的评价' : '提交今天的评价'}}
  </button>

  <view class="tip" wx:if="{{canRate && submitted}}">
    今天已经评价过啦，再次提交会覆盖原来的哦～
  </view>
  <view class="tip" wx:elif="{{canRate}}">每天留下一条，把普通日子慢慢变成共同回忆 🌹</view>
</view>
