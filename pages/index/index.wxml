<view class="container">
  <view class="brand-hero">
    <view class="brand-mark">
      <view class="brand-heart">♥</view>
      <view class="brand-spark"></view>
    </view>
    <view class="brand-copy">
      <view class="brand-name">热念</view>
      <view class="brand-tagline">把每天的喜欢和在意，好好记下来</view>
    </view>
  </view>

  <view class="date-header">
    <view class="date-day">{{dayNum}}</view>
    <view class="date-meta">
      <view class="date-ym">{{yearMonth}}</view>
      <view class="date-week">{{weekDay}}</view>
    </view>
    <view class="date-tip {{submitted ? 'date-tip-done' : ''}}">
      {{bindingStatus !== 'active' ? '未绑定' : (submitted ? '✓ 我已评价' : '待评价')}}
    </view>
  </view>

  <view
    class="bind-banner"
    wx:if="{{!authLoading && bindingStatus !== 'active'}}"
    bindtap="goBind"
  >
    <view class="bind-banner-icon">💕</view>
    <view class="bind-banner-body">
      <view class="bind-banner-title">
        {{bindingStatus === 'waiting' ? '等待 TA 加入' : '先完成双人绑定'}}
      </view>
      <view class="bind-banner-sub">
        {{bindingStatus === 'waiting' ? '打开绑定页复制绑定码或刷新状态' : '绑定后你和 TA 每天都可以各评价一次'}}
      </view>
    </view>
    <view class="bind-banner-arrow">›</view>
  </view>

  <view class="partner-today" wx:if="{{bindingStatus === 'active' && partnerRating}}">
    <view class="partner-title">TA 今天给你的评价</view>
    <view class="partner-main">
      <text class="partner-emoji">{{partnerRating.type === 'good' ? '👍' : '👎'}}</text>
      <text class="partner-label">{{partnerRating.type === 'good' ? '好评' : '差评'}}</text>
    </view>
    <view class="partner-reason" wx:if="{{partnerRating.reason}}">{{partnerRating.reason}}</view>
  </view>

  <view
    class="feature-entry"
    wx:if="{{bindingStatus === 'active'}}"
    bindtap="goPermissions"
  >
    <view class="feature-entry-icon">💗</view>
    <view class="feature-entry-body">
      <view class="feature-entry-title">权限管理</view>
      <view class="feature-entry-sub">亲嘴权、抱抱权……你们自己的小约定</view>
    </view>
    <view class="feature-entry-arrow">›</view>
  </view>

  <view
    class="feature-entry feature-entry-ticket"
    wx:if="{{bindingStatus === 'active'}}"
    bindtap="goPrivileges"
  >
    <view class="feature-entry-icon feature-entry-icon-ticket">🎟️</view>
    <view class="feature-entry-body">
      <view class="feature-entry-title">特权卡</view>
      <view class="feature-entry-sub">给 TA 一张「和好一次」，收到后可使用一次</view>
    </view>
    <view class="feature-entry-arrow">›</view>
  </view>

  <view class="card">
    <view class="card-title">今天你想怎么评价 TA？</view>
    <view class="choice-row">
      <view
        class="choice {{type === 'good' ? 'choice-good-active' : ''}} {{canRate ? '' : 'choice-disabled'}}"
        bindtap="selectGood"
      >
        <view class="choice-emoji">👍</view>
        <view class="choice-label">好评</view>
        <view class="choice-sub">今天很棒</view>
      </view>
      <view
        class="choice {{type === 'bad' ? 'choice-bad-active' : ''}} {{canRate ? '' : 'choice-disabled'}}"
        bindtap="selectBad"
      >
        <view class="choice-emoji">👎</view>
        <view class="choice-label">差评</view>
        <view class="choice-sub">有待改进</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">
      想对 TA 说的话 <text class="optional">（选填）</text>
    </view>
    <textarea
      class="reason-input {{canRate ? '' : 'reason-input-disabled'}}"
      placeholder="开心、委屈、感谢或小情绪，都可以写给 TA～"
      placeholder-class="reason-ph"
      value="{{reason}}"
      bindinput="onReasonInput"
      maxlength="200"
      disabled="{{!canRate}}"
      auto-height
    />
    <view class="reason-count">{{reason.length}}/200</view>
  </view>

  <button
    wx:if="{{canRate}}"
    class="submit-btn {{type ? '' : 'submit-btn-disabled'}}"
    bindtap="submit"
    disabled="{{!type || loading}}"
  >
    {{submitted ? '更新我给 TA 的评价' : '提交我给 TA 的评价'}}
  </button>

  <view class="tip" wx:if="{{canRate && submitted}}">
    再次提交只会覆盖你自己今天的这条，不会影响 TA 给你的评价。
  </view>
  <view class="tip" wx:elif="{{canRate}}">你们每天都可以各留一条，双向记录彼此的感受 🌹</view>
</view>
