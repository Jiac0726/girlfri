<view class="today-page">
  <image class="soft-bg" src="/assets/review-blush.jpg" mode="aspectFill"></image>

  <view class="today-head">
    <view>
      <view class="head-label">今天</view>
      <view class="head-date">{{yearMonth}} · {{weekDay}}</view>
    </view>
    <view class="profile-dot" bindtap="goProfile">♡</view>
  </view>

  <view class="question" wx:if="{{bindingStatus === 'active'}}">今天，你觉得我们相处得怎么样？</view>

  <view class="bind-notice" wx:if="{{!authLoading && bindingStatus !== 'active'}}" bindtap="goBind">
    <view class="notice-heart">♡</view>
    <view class="notice-title">{{bindingStatus === 'waiting' ? '正在等待 TA 加入' : '先和 TA 建立双人关系'}}</view>
    <view class="notice-sub">绑定后，你们每天都能各留下一份感受。</view>
    <button class="love-btn mini">去绑定</button>
  </view>

  <block wx:if="{{bindingStatus === 'active'}}">
    <view class="main-card" wx:if="{{!submitted}}">
      <view class="card-title">今天的我们</view>
      <view class="mood-row">
        <view class="mood {{type === 'good' ? 'on good' : ''}}" bindtap="selectGood">
          <view class="mood-face">☺</view><view class="mood-name">很好</view>
        </view>
        <view class="mood {{type === 'neutral' ? 'on neutral' : ''}}" bindtap="selectNeutral">
          <view class="mood-face">◡</view><view class="mood-name">还好</view>
        </view>
        <view class="mood {{type === 'bad' ? 'on bad' : ''}}" bindtap="selectBad">
          <view class="mood-face">︵</view><view class="mood-name">有点糟</view>
        </view>
      </view>
      <textarea class="feeling" placeholder="写一句今天的感受…" placeholder-class="feeling-ph" value="{{reason}}" bindinput="onReasonInput" maxlength="200" />
      <view class="count">{{reason.length}}/200</view>
      <button class="love-btn" bindtap="submit" disabled="{{!type || loading}}">保存今天</button>
    </view>

    <view class="wait-card" wx:if="{{submitted && !partnerRating}}">
      <view class="card-title left">TA 的评价</view>
      <view class="envelope">💌</view>
      <view class="wait-title">还没有收到 TA 的评价</view>
      <view class="wait-sub">双方都完成后才能看到彼此的内容。<br/>再等等吧 ♡</view>
    </view>

    <view class="result-card" wx:if="{{submitted && partnerRating}}">
      <view class="card-title left">今天的我们</view>
      <view class="pair-results">
        <view class="result-col">
          <view class="who">你给 TA</view>
          <view class="result-face">{{type === 'good' ? '☺' : (type === 'neutral' ? '◡' : '︵')}}</view>
          <view class="result-type {{type}}">{{type === 'good' ? '很好' : (type === 'neutral' ? '还好' : '有点糟')}}</view>
          <view class="result-text">「{{reason || '今天也认真记录了一下。'}}」</view>
        </view>
        <view class="result-divider"></view>
        <view class="result-col">
          <view class="who">TA 给你</view>
          <view class="result-face">{{partnerRating.type === 'good' ? '☺' : (partnerRating.type === 'neutral' ? '◡' : '︵')}}</view>
          <view class="result-type {{partnerRating.type}}">{{partnerRating.type === 'good' ? '很好' : (partnerRating.type === 'neutral' ? '还好' : '有点糟')}}</view>
          <view class="result-text">「{{partnerRating.reason || 'TA 留下了今天的感受。'}}」</view>
        </view>
      </view>
      <view class="result-date">{{yearMonth}}.{{dayNum}}</view>
      <view class="edit-link" bindtap="editToday">修改我的评价</view>
    </view>

    <view class="month-card">
      <view class="month-title">本月相处</view>
      <view class="month-grid">
        <view><text>连续好评</text><strong>{{monthStreak}}</strong><em>天</em></view>
        <view><text>本月好评率</text><strong>{{monthGoodRate}}</strong><em>%</em></view>
      </view>
      <view class="heart-line">
        <text wx:for="{{streakHearts}}" wx:key="index" class="{{item ? 'filled' : ''}}">♥</text>
      </view>
      <view class="month-note">已经连续 {{monthStreak}} 天留下记录啦！</view>
      <view class="tiny-actions">
        <view bindtap="goPermissions">小约定</view>
        <view bindtap="goPrivileges">特权卡</view>
      </view>
    </view>
  </block>
</view>