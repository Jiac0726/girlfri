<import src="./entry-card.wxml" />
<view class="journal-page">
  <view class="journal-head">
    <view><view class="eyebrow">热念 · 两个人的日常</view><view class="page-title">把这一刻，留给我们</view><view class="page-sub">{{dateLabel}} · 想说的时候，就记下来。</view></view>
    <button class="profile-link" bindtap="goProfile" aria-label="打开我们">♡</button>
  </view>
  <view class="state-panel" wx:if="{{authLoading}}"><view class="state-symbol">♡</view><view>正在翻开我们的日常…</view></view>
  <view class="state-panel" wx:elif="{{bindingStatus !== 'active' && !error}}">
    <view class="state-symbol">♡</view><view class="state-title">{{bindingStatus === 'waiting' ? '等 TA 一起加入' : '先和 TA 建立双人关系'}}</view>
    <view class="state-copy">把照片、心情和小事，留在两个人的空间里。</view><button class="primary-button" bindtap="goBind">{{bindingStatus === 'waiting' ? '查看邀请' : '和 TA 绑定'}}</button>
  </view>
  <block wx:else>
    <view class="error-panel" wx:if="{{error}}"><text>{{error}}</text><button class="text-button" bindtap="retry" disabled="{{loading}}">重新加载</button></view>
    <block wx:if="{{bindingStatus === 'active'}}">
      <button class="compose-prompt" bindtap="writeEntry" disabled="{{loading}}"><view class="compose-plus">＋</view><view class="compose-copy"><view>记下一刻</view><text>一句话、一张照片，或现在的心情</text></view><text class="compose-arrow">›</text></button>
      <view class="feed-heading"><text>我们的日常</text><text class="feed-note">发布后彼此就能看见</text></view>
      <view class="state-panel compact" wx:if="{{loading && !entries.length}}">正在加载记录…</view>
      <view class="state-panel" wx:elif="{{!entries.length && !error}}"><view class="state-symbol">✿</view><view class="state-title">第一篇，从今天开始</view><view class="state-copy">不用特别的事，平常的一天也值得留下。</view></view>
      <template wx:for="{{entries}}" wx:key="id" is="entry-card" data="{{entry:item, busyEntryId:busyEntryId, locked:loading}}" />
      <view class="list-footer" wx:if="{{entries.length}}">
        <view wx:if="{{loadingMore}}">正在翻开更多日常…</view>
        <button wx:elif="{{moreError}}" class="text-button" bindtap="loadMore">{{moreError}} · 重试</button>
        <button wx:elif="{{hasMore}}" class="text-button" bindtap="loadMore">看看更早的日常</button>
        <view wx:else>已经翻到最初的那一页 ♡</view>
      </view>
    </block>
  </block>
</view>
