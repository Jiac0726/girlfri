page{background:#fdf5f6;color:#3e2b33}.journal-page{min-height:100vh;padding:44rpx var(--page-gutter) 70rpx;box-sizing:border-box;background:radial-gradient(ellipse at top right,#f9e2e7,transparent 65%)}.journal-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:36rpx}.page-title{font-size:40rpx;line-height:1.4;font-weight:650;margin-top:16rpx;letter-spacing:1rpx}.page-sub{font-size:24rpx;color:#977d88;margin-top:16rpx}.profile-link{flex-shrink:0;width:70rpx;height:70rpx;padding:0;margin:0;border-radius:50%;background:#fff8fa;color:#c34e67;font-size:42rpx;line-height:70rpx}.profile-link:after,button:after{border:0}.quick-actions{display:grid;grid-template-columns:190rpx minmax(0,1fr);gap:16rpx;align-items:stretch}.miss-prompt,.compose-prompt{min-height:176rpx;box-sizing:border-box;border:1rpx solid #e8bdc8;border-radius:var(--card-radius);background:#fffafb;color:#6b384b}.miss-prompt{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:18rpx 12rpx;margin:0;line-height:1.25}.miss-heart{font-size:42rpx;line-height:1;color:#bd5d79}.miss-title{margin-top:10rpx;font-size:28rpx;font-weight:650}.miss-received{margin-top:8rpx;font-size:19rpx;color:#a74765;font-weight:600;white-space:nowrap}.miss-hint{margin-top:8rpx;font-size:18rpx;color:#a1848f;white-space:nowrap}.miss-prompt[disabled]{background:#fffafb;color:#8e6b79;opacity:.72}.compose-prompt{display:flex;align-items:center;width:100%;text-align:left;padding:28rpx;margin:0;line-height:1.5}.compose-plus{width:68rpx;height:68rpx;line-height:68rpx;text-align:center;border-radius:50%;background:#f9e3e9;font-size:40rpx;margin-right:22rpx}.compose-copy{flex:1;font-size:30rpx;font-weight:600}.compose-copy text{display:block;font-size:22rpx;font-weight:400;color:#967580;margin-top:6rpx}.compose-arrow{font-size:40rpx;color:#ba8393}.feed-heading{display:flex;justify-content:space-between;align-items:center;margin:44rpx 4rpx 22rpx;font-size:29rpx;font-weight:600}.feed-note{font-size:20rpx;font-weight:400;color:#977d88}.entry-card{width:100%;box-sizing:border-box;padding:var(--card-pad);margin-bottom:24rpx;border-radius:var(--card-radius);border:1rpx solid #f0dce2;background:#fffbfc}.entry-top{display:flex;align-items:center;gap:18rpx}.entry-avatar{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:68rpx;height:68rpx;border-radius:50%;font-size:24rpx;color:#86465b;background:#f4dce4}.entry-avatar.partner{background:#f1e3dc;color:#8d604c}.entry-byline{flex:1;min-width:0}.entry-author{font-size:26rpx;font-weight:600}.entry-time{margin-top:4rpx;font-size:21rpx;color:#a18a94}.entry-mood{font-size:40rpx}.entry-text{display:block;margin-top:26rpx;font-size:29rpx;line-height:1.85;white-space:pre-wrap;word-break:break-word;color:#533d48}.entry-images{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8rpx;margin-top:24rpx}.entry-image-cell{height:190rpx;overflow:hidden;border-radius:12rpx;background:#f5e9ed}.entry-image{width:100%;height:100%;display:block}.single-image{grid-template-columns:minmax(0,1fr)}.single-image .entry-image-cell{height:430rpx}.image-placeholder{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:20rpx;color:#a17d8a}.image-placeholder text{font-size:18rpx;margin-top:8rpx}.entry-actions{display:flex;justify-content:flex-end;gap:24rpx;margin-top:24rpx;border-top:1rpx solid #f5e8ec;padding-top:16rpx}.text-button{padding:8rpx 4rpx;margin:0;background:transparent;color:#ab4965;line-height:1.6;font-size:24rpx;min-height:48rpx}.text-button.muted{color:#a08892}.text-button[disabled]{background:transparent;color:#bea6b0}.state-panel{text-align:center;padding:70rpx 26rpx;color:#977d88;font-size:26rpx}.state-panel.compact{padding:44rpx 12rpx}.state-symbol{color:#d795a8;font-size:78rpx;margin-bottom:22rpx}.state-title{color:#704b5c;font-size:32rpx;font-weight:600}.state-copy{font-size:25rpx;line-height:1.8;margin:18rpx auto 0;max-width:510rpx}.primary-button{border-radius:44rpx;color:#fff6f8;background:#9f415d;font-size:28rpx;line-height:86rpx;margin-top:36rpx}.primary-button[disabled]{background:#d9b5c2;color:#fff6f8}.error-panel{padding:22rpx 24rpx;margin-bottom:24rpx;background:#fce6ec;border-radius:18rpx;color:#99435c;font-size:24rpx;word-break:break-word}.error-panel .text-button{margin-top:10rpx}.list-footer{text-align:center;padding:24rpx 0;color:#b19aa4;font-size:22rpx}.list-footer .text-button{margin:0 auto}
.entry-meta-row{display:flex;align-items:center;gap:10rpx;flex-wrap:wrap;margin-top:22rpx}.entry-rating-badge,.legacy-private-badge{display:inline-flex;align-items:center;padding:8rpx 14rpx;border-radius:999rpx;font-size:19rpx}.entry-rating-badge{background:#f6e9ed;color:#8c6573;font-weight:600}.entry-rating-badge.good{background:#f9e2e7;color:#b34d66}.entry-rating-badge.neutral{background:#f3eee9;color:#8a7569}.entry-rating-badge.bad{background:#eee9ed;color:#786674}.legacy-private-badge{background:#f1edf0;color:#9a8790}

.daily-overview{width:100%;box-sizing:border-box;padding:28rpx;border:1rpx solid #edd9df;border-radius:var(--card-radius);background:linear-gradient(145deg,#fffafb,#fdf1f4);box-shadow:0 8rpx 24rpx rgba(123,61,82,.05)}
.overview-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx}
.overview-kicker{font-size:21rpx;color:#a0818d}
.overview-title{margin-top:8rpx;font-size:30rpx;line-height:1.45;font-weight:650;color:#5a3f4a}
.overview-arrow{flex-shrink:0;color:#bd748b;font-size:46rpx;line-height:1}
.overview-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin-top:26rpx;padding:22rpx 0;border-top:1rpx solid #f0e0e5;border-bottom:1rpx solid #f0e0e5}
.overview-stat{text-align:center;color:#9a7e89;font-size:20rpx}
.overview-stat text{display:block;margin-bottom:4rpx;color:#6f4657;font-size:38rpx;font-weight:700;line-height:1.2}
.overview-foot{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding-top:20rpx;color:#9d7f8b;font-size:22rpx}
.overview-foot text:last-child{color:#ab4f6c;font-weight:600}
