page{background:#fff5f6;color:#17283a}.today-page{min-height:100vh;padding:34rpx 34rpx 150rpx;box-sizing:border-box;position:relative;overflow:hidden}.soft-bg{position:fixed;top:0;right:0;bottom:0;left:0;width:100%;height:100%;opacity:.23;z-index:0;pointer-events:none}.today-page:after{content:"";position:fixed;top:0;right:0;bottom:0;left:0;background:linear-gradient(180deg,rgba(255,248,249,.84),rgba(255,244,246,.94));z-index:1;pointer-events:none}.today-head{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:flex-start}.head-label{font-size:26rpx;color:#7c8189}.head-date{font-size:42rpx;font-weight:600;margin-top:12rpx;color:#626a73}.profile-dot{width:72rpx;height:72rpx;border-radius:50%;background:rgba(255,255,255,.82);display:flex;align-items:center;justify-content:center;color:#ef5d74;font-size:46rpx;box-shadow:0 8rpx 22rpx rgba(199,105,122,.14)}.question{position:relative;z-index:2;font-size:40rpx;font-weight:700;line-height:1.45;margin:34rpx 0 30rpx}.main-card,.wait-card,.result-card,.month-card,.bind-notice{position:relative;z-index:2;background:rgba(255,255,255,.84);border:1px solid rgba(246,207,214,.72);border-radius:38rpx;box-shadow:0 20rpx 60rpx rgba(181,102,116,.09)}.main-card{padding:36rpx 30rpx}.card-title{text-align:center;font-size:34rpx;font-weight:700}.card-title.left{text-align:left}.mood-row{display:flex;gap:18rpx;justify-content:space-between;margin-top:34rpx}.mood{flex:1;border-radius:30rpx;padding:26rpx 8rpx 20rpx;text-align:center;background:#f8f5f5;border:1px solid transparent}.mood.on{background:#fff0f3;border-color:#ffc6d0}.mood-face{width:86rpx;height:86rpx;margin:0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#eceff1;color:#173047;font-size:48rpx}.mood.on.good .mood-face{background:#ffc7d0;color:#e84c64}.mood.on.neutral .mood-face{background:#ffe7bf;color:#b6782c}.mood.on.bad .mood-face{background:#e1e5ea;color:#5c6670}.mood-name{margin-top:12rpx;font-size:27rpx}.mood.on .mood-name{color:#e94f68;font-weight:600}.feeling{box-sizing:border-box;width:100%;min-height:190rpx;margin-top:28rpx;border:1px solid #f1cbd2;border-radius:28rpx;padding:24rpx;font-size:28rpx;line-height:1.7;background:rgba(255,255,255,.62)}.feeling-ph{color:#adb0b5}.count{text-align:right;color:#a7a8ad;font-size:22rpx;margin-top:8rpx}.love-btn{height:96rpx;margin-top:24rpx;border:none;border-radius:48rpx;background:linear-gradient(90deg,#ff7487,#f13e5c);color:#fff;font-size:31rpx;line-height:96rpx;font-weight:600;box-shadow:0 14rpx 36rpx rgba(241,66,94,.2)}.love-btn::after{border:none}.love-btn[disabled]{opacity:.45}.bind-notice{text-align:center;padding:70rpx 30rpx;margin-top:70rpx}.notice-heart{font-size:92rpx;color:#f05d74}.notice-title{font-size:36rpx;font-weight:700}.notice-sub{font-size:26rpx;color:#7b8189;margin-top:16rpx}.love-btn.mini{width:70%;margin:32rpx auto 0}.wait-card{margin-top:18rpx;padding:38rpx 34rpx 60rpx;text-align:center}.envelope{font-size:104rpx;margin-top:70rpx}.wait-title{font-size:32rpx;font-weight:700;margin-top:30rpx}.wait-sub{font-size:25rpx;color:#76808a;line-height:1.8;margin-top:20rpx}.result-card{padding:38rpx 28rpx 28rpx}.pair-results{display:flex;margin-top:34rpx}.result-col{flex:1;text-align:center;padding:0 14rpx}.result-divider{width:1px;background:#f2ccd3}.who{font-size:25rpx;color:#5f6872}.result-face{width:84rpx;height:84rpx;border-radius:50%;background:#ffd7de;margin:18rpx auto 8rpx;display:flex;align-items:center;justify-content:center;font-size:46rpx}.result-type{font-size:30rpx;font-weight:700}.result-type.good{color:#ef4962}.result-type.neutral{color:#ba7e2e}.result-type.bad{color:#68717c}.result-text{font-size:24rpx;line-height:1.7;margin-top:16rpx;color:#40505e}.result-date{text-align:center;color:#9a9da2;font-size:23rpx;margin-top:30rpx}.edit-link{text-align:center;color:#d85569;font-size:23rpx;margin-top:12rpx}.month-card{margin-top:24rpx;padding:34rpx}.month-title{font-size:32rpx;font-weight:700}.month-