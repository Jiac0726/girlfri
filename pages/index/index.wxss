/* ═══════════════════════════════════════════════════════════
   今日 · 私密手账 / Intimate Editorial
   原则：字阶对比做主角 · hairline 分层 · 左对齐 · 零阴影零渐变
   ═══════════════════════════════════════════════════════════ */

/* ── 报头 ─────────────────────────────────────────────────── */
.masthead {
  padding-bottom: var(--s-3);
  border-bottom: 2rpx solid var(--ink);
}

.masthead-name {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 22rpx;   /* 拉开字距，像刊名 */
  line-height: 1.1;
}

.masthead-tag {
  display: block;
  margin-top: var(--s-2);
  font-size: 21rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
}

/* ── 日期刊头：极繁数字 vs 极简小字 ───────────────────────── */
.dateline {
  display: flex;
  align-items: baseline;
  padding: var(--s-4) 0 var(--s-3);
  border-bottom: 1rpx solid var(--rule);
}

.dateline-num {
  font-size: 168rpx;        /* 主视觉，比原来的 108rpx 大得多 */
  font-weight: 800;
  color: var(--ink);
  line-height: 0.82;
  letter-spacing: -10rpx;   /* 负字距让大数字收拢，不像手机号 */
}

.dateline-side {
  margin-left: var(--s-3);
  padding-bottom: 0;
  display: flex;
  flex-direction: column;
}

.dateline-ym {
  font-size: 24rpx;
  color: var(--ink-2);
  letter-spacing: 3rpx;
}

.dateline-week {
  margin-top: var(--s-1);
  font-size: 20rpx;
  color: var(--ink-3);
  letter-spacing: 6rpx;
}

.dateline-state {
  margin-left: auto;
  padding-bottom: 0;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--rose);
  border-bottom: 2rpx solid var(--rose);
}

.dateline-state.is-done {
  color: var(--ink-3);
  border-bottom-color: var(--rule);
}

/* ── 待完成 / 提示条 ──────────────────────────────────────── */
.notice {
  display: flex;
  align-items: center;
  padding: var(--s-3) 0;
  border-bottom: 1rpx solid var(--rule);
}

.notice-body {
  flex: 1;
  min-width: 0;
  margin-top: var(--s-1);
  display: flex;
  flex-direction: column;
}

.notice-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.notice-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-3);
}

/* ── TA 的评价 ────────────────────────────────────────────── */
.partner {
  padding: var(--s-3) 0;
  border-bottom: 1rpx solid var(--rule);
}

.partner-line {
  display: flex;
  align-items: center;
  margin-top: var(--s-2);
}

.partner-mark {
  width: 18rpx;
  height: 18rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.mark-good {
  background: var(--rose);
}
.mark-bad {
  background: var(--ink-2);
}

.partner-label {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.partner-reason {
  display: block;
  margin-top: var(--s-2);
  font-size: 26rpx;
  line-height: 1.9;
  color: var(--ink-2);
}

/* ── 功能入口：列表行，不是卡片 ───────────────────────────── */
.entry {
  display: flex;
  align-items: center;
  padding: var(--s-3) 0;
  border-bottom: 1rpx solid var(--rule);
}

.entry-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.entry-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.entry-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ink-3);
}

/* ── 段落 ─────────────────────────────────────────────────── */
.section {
  padding-top: var(--s-4);
}

.section-head {
  display: flex;
  align-items: baseline;
}

/* ── 勾选式评价 ───────────────────────────────────────────── */
.choices {
  margin-top: var(--s-2);
  border-top: 1rpx solid var(--rule);
}

.choice {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: var(--s-3) 0;
  border-bottom: 1rpx solid var(--rule);
  transition: opacity 0.2s var(--ease);
}

.choice.is-off {
  opacity: 0.4;
}

.tick {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid var(--ink-3);
  margin-right: var(--s-3);
  flex-shrink: 0;
  position: relative;
  transition: background 0.18s var(--ease), border-color 0.18s var(--ease);
}

.tick-on {
  background: var(--rose);
  border-color: var(--rose);
}

.tick-bad.tick-on {
  background: var(--ink-2);
  border-color: var(--ink-2);
}

.tick-on::after {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 4rpx;
  width: 9rpx;
  height: 18rpx;
  border: 3rpx solid var(--paper);
  border-top: 0;
  border-left: 0;
  transform: rotate(42deg);
}

.choice-body {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
  height: 52rpx;
}

.choice-label {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 2rpx;
  line-height: 52rpx;
}

.choice-sub {
  margin-left: var(--s-2);
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 52rpx;
}

/* ── 书写区：只要一条底线，不要填充色块 ───────────────────── */
.compose {
  width: 100%;
  min-height: 132rpx;
  margin-top: var(--s-2);
  padding: var(--s-2) 0;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.9;
  color: var(--ink);
  border-bottom: 1rpx solid var(--rule);
  transition: border-color 0.2s var(--ease);
}

.compose:focus {
  border-bottom-color: var(--rose);
}

.compose.is-off {
  color: var(--ink-3);
}

.compose-ph {
  color: var(--ink-3);
}

.count {
  display: block;
  margin-top: var(--s-1);
  text-align: right;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

/* ── 主操作：实心墨块 ─────────────────────────────────────── */
.submit {
  margin-top: var(--s-4) !important;
  background: var(--blush) !important;
  color: var(--berry) !important;
  border: 2rpx solid var(--rose);
  border-radius: 6rpx !important;
  font-size: 27rpx !important;
  font-weight: 600 !important;
  letter-spacing: 6rpx;
  height: 96rpx;
  line-height: 92rpx;
  box-shadow: none !important;
  transition: background 0.2s var(--ease), color 0.2s var(--ease);
}

.submit::after {
  border: none;
}

.submit:active {
  background: var(--rose) !important;
  color: var(--paper) !important;
}

.submit-off {
  background: transparent !important;
  color: var(--ink-3) !important;
  box-shadow: inset 0 0 0 2rpx var(--rule) !important;
}
