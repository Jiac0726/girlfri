.settings-page {
  min-height: 100%;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}

.settings-header {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx 42rpx;
}

button.settings-back {
  flex-shrink: 0;
  width: 72rpx !important;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx !important;
  margin: 0 22rpx 0 0;
  padding: 0 !important;
  box-sizing: border-box;
  border-radius: 50% !important;
  background: #fff7f8;
  border: 2rpx solid #f2dce2;
  color: #8f6a76;
  font-size: 46rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

button.settings-back::after {
  border: 0;
  border-radius: 50%;
}

.settings-header-copy {
  flex: 1;
  min-width: 0;
}

.settings-eyebrow {
  color: #ff6b81;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.settings-title {
  margin-top: 4rpx;
  color: #4a3540;
  font-size: 40rpx;
  font-weight: 800;
}

.settings-sub {
  margin-top: 6rpx;
  color: #a98894;
  font-size: 22rpx;
}

.settings-card {
  margin-bottom: 24rpx;
  padding: 10rpx 0;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 2rpx solid #f1e1e6;
  box-shadow: 0 8rpx 28rpx rgba(97, 59, 73, 0.05);
}

.settings-section-title {
  padding: 22rpx 28rpx 12rpx;
  color: #8f6f7b;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.settings-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 18rpx 28rpx;
  box-sizing: border-box;
}

.settings-row + .settings-row {
  border-top: 1rpx solid #f4e8ec;
}

.settings-row-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #fff0f4;
  color: #d45b74;
  font-size: 30rpx;
  line-height: 64rpx;
  text-align: center;
  flex-shrink: 0;
}

.settings-row-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.settings-row-title {
  color: #4f3b44;
  font-size: 27rpx;
  font-weight: 700;
}

.settings-row-sub {
  margin-top: 5rpx;
  color: #aa8e98;
  font-size: 20rpx;
  line-height: 1.55;
}

.settings-row-arrow {
  margin-left: 16rpx;
  color: #d28a9a;
  font-size: 38rpx;
}

.settings-footer {
  margin-top: 36rpx;
  color: #b99fa8;
  font-size: 20rpx;
  text-align: center;
}


.settings-error {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #fff0f3;
  color: #a94e67;
  font-size: 22rpx;
  line-height: 1.6;
}

.miss-setting {
  padding: 16rpx 28rpx 28rpx;
}

.miss-setting-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.miss-setting-head > view:first-child {
  flex: 1;
  min-width: 0;
}

.miss-setting-badge {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f8e6ec;
  color: #a64d68;
  font-size: 19rpx;
  line-height: 1.4;
}

.miss-setting-status {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  color: #9f828d;
  font-size: 21rpx;
  line-height: 1.5;
}

.miss-setting-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #d7c6cc;
  flex-shrink: 0;
}

.miss-setting-dot.active {
  background: #ff6b81;
  box-shadow: 0 0 0 7rpx rgba(255, 107, 129, 0.12);
}

button.miss-setting-button {
  width: 100% !important;
  box-sizing: border-box;
  height: 82rpx;
  margin: 20rpx 0 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #9f415d;
  color: #fff8fa;
  font-size: 24rpx;
  line-height: 82rpx;
}

button.miss-setting-button::after {
  border: 0;
}

button.miss-setting-button[disabled] {
  background: #ead9df;
  color: #b99fa8;
}

.miss-setting-note {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff8fa;
  color: #b0919c;
  font-size: 20rpx;
  line-height: 1.65;
}


.daily-reminder-setting {
  padding: 16rpx 28rpx 26rpx;
  border-bottom: 1rpx solid #f4e8ec;
}

.daily-reminder-head,
.daily-reminder-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.daily-reminder-head > view:first-child,
.daily-reminder-time-row > view:first-child {
  flex: 1;
  min-width: 0;
}

.daily-reminder-time-row {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #f5eaed;
}

.daily-reminder-time {
  min-width: 118rpx;
  padding: 12rpx 0 12rpx 18rpx;
  color: #a64d68;
  font-size: 23rpx;
  font-weight: 700;
  text-align: right;
}

.daily-reminder-status {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  color: #9f828d;
  font-size: 21rpx;
  line-height: 1.5;
}

.daily-reminder-status.active {
  color: #a64d68;
}

.daily-reminder-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #d7c6cc;
  flex-shrink: 0;
}

.daily-reminder-status.active .daily-reminder-dot {
  background: #ff6b81;
  box-shadow: 0 0 0 7rpx rgba(255, 107, 129, 0.12);
}

.daily-reminder-note {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff8fa;
  color: #b0919c;
  font-size: 20rpx;
  line-height: 1.65;
}


.account-action {
  flex-shrink: 0;
  margin-left: 14rpx;
  color: #a64d68;
  font-size: 21rpx;
  font-weight: 700;
}

.account-status-pill {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff0f4;
  color: #a64d68;
  font-size: 19rpx;
  line-height: 1.4;
}

.account-info-row {
  cursor: default;
}


.account-avatar-row {
  min-height: 132rpx;
}

button.account-avatar-button {
  flex-shrink: 0;
  width: 76rpx !important;
  min-width: 76rpx;
  max-width: 76rpx;
  height: 76rpx !important;
  margin: 0;
  padding: 0 !important;
  overflow: hidden;
  border-radius: 50% !important;
  background: #fff0f4;
  border: 2rpx solid #f1d7df;
  line-height: 76rpx;
}

button.account-avatar-button::after {
  border: 0;
  border-radius: 50%;
}

button.account-avatar-button[disabled] {
  opacity: 0.55;
}

.account-avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.account-avatar-placeholder {
  width: 100%;
  height: 100%;
  color: #c65d77;
  font-size: 34rpx;
  line-height: 72rpx;
  text-align: center;
}
