<view class="love-page">
  <image class="paper-bg" src="../../assets/review-blush.png" mode="aspectFill"></image>

  <block wx:if="{{bindingStatus === 'unbound' && !openedFromInvite}}">
    <view class="welcome-stage target-welcome">
      <view class="brand-block">
        <view class="logo-heart-box">
          <view class="heart-ray ray-a"></view>
          <view class="heart-ray ray-b"></view>
          <view class="heart-ray ray-c"></view>
          <view class="brand-heart">♥</view>
        </view>
        <view class="brand-name">热念<text class="brand-dot">♥</text></view>
        <view class="brand-sub">两个人的相处记录</view>
      </view>

      <view class="story-zone">
        <view class="hand-note note-left">平凡的日子\n因为有你\n而闪闪发光 ♡</view>
        <view class="hand-note note-right">和你在一起\n就是最好的时光 ♡</view>
        <view class="doodle-heart h1">♡</view>
        <view class="doodle-heart h2">♡</view>
        <image class="welcome-photo" src="../../assets/bind-couple.jpg" mode="aspectFill"></image>
        <view class="story-fade"></view>
      </view>

      <view class="welcome-actions">
        <button class="love-btn welcome-bind" bindtap="createInvite" loading="{{loading}}">和 TA 绑定</button>
        <view class="text-link invite-received" bindtap="showManualJoin">我已经收到邀请 <text class="link-arrow">→</text></view>

        <view class="manual-join" wx:if="{{manualJoin}}">
          <view class="manual-title">输入 TA 发来的绑定码</view>
          <input class="code-input" value="{{joinCode}}" bindinput="onJoinInput" maxlength="8" placeholder="8 位绑定码" />
          <button class="outline-btn" bindtap="joinPair" disabled="{{joinCode.length !== 8 || loading}}">完成绑定</button>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{bindingStatus === 'unbound' && openedFromInvite}}">
    <view class="flow-stage">
      <view class="flow-title">邀请 TA</view>
      <image class="invite-art" src="../../assets/waiting-envelope.jpg" mode="aspectFit"></image>
      <view class="invite-main">TA 邀请你<br/>一起使用热念</view>
      <view class="invite-sub">记录平凡日子里的特别时刻<br/>让爱被看见 ♡</view>
      <view class="invite-code">{{joinCode}}</view>
      <button class="love-btn" bindtap="joinPair" loading="{{loading}}">接受邀请并绑定</button>
      <view class="text-link" bindtap="useOtherCode">使用其他绑定码</view>
    </view>
  </block>

  <block wx:if="{{bindingStatus === 'waiting'}}">
    <view class="flow-stage">
      <view class="flow-title">邀请 TA</view>
      <image class="invite-art" src="../../assets/waiting-envelope.jpg" mode="aspectFit"></image>
      <view class="invite-main">邀请 TA<br/>和你一起使用热念</view>
      <view class="invite-sub">记录平凡日子里的特别时刻<br/>让爱被看见 ♡</view>
      <button class="love-btn wechat-btn" open-type="share">微信邀请</button>
      <view class="divider"><text></text><view>或使用邀请码</view><text></text></view>
      <view class="invite-code" bindtap="copyCode">{{inviteCode}}</view>
      <view class="expire">邀请码 {{inviteExpiresText ? '有效至 ' + inviteExpiresText : '7 天内有效'}}</view>
      <view class="mini-actions">
        <view bindtap="copyCode">复制邀请码</view>
        <view bindtap="refreshInvite">换一个</view>
        <view bindtap="cancelInvite">取消</view>
      </view>
      <button class="outline-btn" bindtap="retrySession" loading="{{loading}}" disabled="{{loading}}">TA 已加入？刷新状态</button>
    </view>
  </block>

  <block wx:if="{{bindingStatus === 'active'}}">
    <view class="success-stage">
      <view class="flow-title">绑定成功</view>
      <image class="success-pair-art" src="../../assets/success-pair.jpg" mode="aspectFit"></image>
      <view class="success-title">连接成功</view>
      <view class="invite-sub">从今天开始，<br/>留下一点属于你们的记录。</view>
      <button class="love-btn" bindtap="backHome">开始记录</button>
      <view class="hand-note success-note">好的关系<br/>是一起把平凡的日子<br/>过成特别的回忆 ♡</view>
    </view>
  </block>

  <view class="loading-cover" wx:if="{{bindingStatus === 'loading'}}">正在准备你们的空间…</view>
  <view class="flow-stage" wx:if="{{bindingStatus === 'error'}}">
    <view class="flow-title">暂时连接不上</view>
    <view class="invite-sub">{{errorMessage}}</view>
    <button class="love-btn" bindtap="retrySession" loading="{{loading}}" disabled="{{loading}}">重新加载</button>
    <view class="text-link" bindtap="backHome">返回首页</view>
  </view>
</view>
