<view class="love-page">
  <block wx:if="{{bindingStatus === 'unbound' && !openedFromInvite}}">
    <image class="welcome-photo" src="../../assets/bind-couple-portrait.jpg" mode="aspectFill" />
    <view class="story-fade"></view>
  </block>
  <view class="bind-nav" style="padding-top:{{statusBarHeight}}px">
    <button class="back-link" bindtap="backHome" aria-label="返回首页">‹</button>
    <text>{{bindingStatus === 'active' ? '绑定成功' : bindingStatus === 'waiting' ? '邀请 TA' : openedFromInvite ? '接受邀请' : '热念'}}</text>
  </view>
  <view wx:if="{{bindingStatus === 'unbound' && !openedFromInvite}}" class="welcome-stage">
    <view class="brand-block"><view class="brand-heart">♡<text>✧</text></view><view class="brand-name">热 念</view><view class="brand-sub">两个人的相处记录</view></view>
    <view class="story-zone">
      <view class="hand-note story-note"><view>平凡的日子</view><view>因为有你</view><view>而闪闪发光 ♡</view></view>
    </view>
    <view class="welcome-actions">
      <button class="love-btn" bindtap="createInvite" loading="{{loading}}" disabled="{{loading}}">和 TA 绑定</button>
      <button class="text-link" bindtap="showManualJoin">我已经收到邀请 →</button>
      <view class="manual-join" wx:if="{{manualJoin}}">
        <view class="manual-title">输入 TA 发来的 8 位绑定码</view>
        <input class="code-input" value="{{joinCode}}" bindinput="onJoinInput" maxlength="8" placeholder="8 位绑定码" />
        <button class="outline-btn" bindtap="joinPair" disabled="{{joinCode.length !== 8 || loading}}">完成绑定</button>
      </view>
    </view>
  </view>
  <view wx:if="{{bindingStatus === 'waiting' || (bindingStatus === 'unbound' && openedFromInvite)}}" class="flow-stage">
    <view class="invite-card">
      <view class="invite-mark">♡</view>
      <view class="invite-title"><view>{{bindingStatus === 'waiting' ? '邀请你喜欢的那个人' : 'TA 邀请你'}}</view><view>和 TA 一起使用热念</view></view>
      <view class="invite-sub"><view>记录平凡日子里的特别时刻</view><view>让爱被看见 ♡</view></view>
      <button wx:if="{{bindingStatus === 'waiting'}}" class="love-btn invite-send" open-type="share" disabled="{{loading || inviteExpired}}"><text>♡</text> 微信邀请</button>
      <button wx:else class="love-btn invite-send" bindtap="joinPair" loading="{{loading}}" disabled="{{loading}}">接受邀请并绑定</button>
      <view class="code-divider"><text></text><view>{{bindingStatus === 'waiting' ? '或使用邀请码' : '来自 TA 的邀请码'}}</view><text></text></view>
      <button class="invite-code" bindtap="copyCode" disabled="{{bindingStatus !== 'waiting' || loading || inviteExpired}}" aria-label="复制邀请码"><text>{{bindingStatus === 'waiting' ? inviteCode : joinCode}}</text><text class="copy-mark" wx:if="{{bindingStatus === 'waiting'}}">▢</text></button>
      <view wx:if="{{bindingStatus === 'waiting'}}" class="expire">{{inviteExpired ? '邀请已过期，请重新生成' : inviteExpiresText ? '有效至 ' + inviteExpiresText : '24 小时内有效'}}</view>
      <view wx:if="{{bindingStatus === 'waiting'}}" class="mini-actions"><button bindtap="refreshInvite" disabled="{{loading}}">换一个邀请码</button><button bindtap="cancelInvite" disabled="{{loading}}">取消邀请</button></view>
    </view>
    <button wx:if="{{bindingStatus === 'waiting'}}" class="text-link" bindtap="retrySession" disabled="{{loading}}">TA 已加入？刷新状态 →</button>
    <button wx:if="{{bindingStatus === 'waiting'}}" class="text-link secondary-link" bindtap="showManualJoin">我也收到了 TA 的邀请</button>
    <button wx:else class="text-link" bindtap="useOtherCode">使用其他绑定码 →</button>
    <view class="manual-join" wx:if="{{bindingStatus === 'waiting' && (manualJoin || openedFromInvite)}}">
      <input class="code-input" value="{{joinCode}}" bindinput="onJoinInput" maxlength="8" placeholder="输入 TA 的 8 位绑定码" />
      <button class="outline-btn" bindtap="joinPair" disabled="{{joinCode.length !== 8 || loading}}">接受 TA 的邀请</button>
    </view>
    <view class="flow-signature">想和你，收藏每一个普通日子。</view>
  </view>
  <view wx:if="{{bindingStatus === 'active'}}" class="success-stage">
    <view class="success-avatar-pair">
      <view class="success-avatar-person">
        <button
          class="success-avatar-button"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
          loading="{{avatarSaving}}"
          disabled="{{avatarSaving || loading}}"
          aria-label="设置我的微信头像"
        >
          <image wx:if="{{myAvatarUrl}}" class="success-avatar-image" src="{{myAvatarUrl}}" mode="aspectFill" />
          <view wx:else class="success-avatar-placeholder">我</view>
        </button>
        <view class="success-avatar-label">{{myAvatarUrl ? '我' : '设置我的头像'}}</view>
      </view>

      <view class="success-avatar-heart">♡</view>

      <view class="success-avatar-person">
        <view class="success-avatar-static">
          <image wx:if="{{partnerAvatarUrl}}" class="success-avatar-image" src="{{partnerAvatarUrl}}" mode="aspectFill" />
          <view wx:else class="success-avatar-placeholder">TA</view>
        </view>
        <view class="success-avatar-label">{{partnerAvatarUrl ? 'TA' : '等待 TA 设置头像'}}</view>
      </view>
    </view>

    <view class="success-avatar-hint" wx:if="{{!myAvatarUrl}}">
      点击“我”的头像，可直接使用微信头像
    </view>

    <view class="success-title">连接成功</view>
    <view class="invite-sub"><view>从今天开始，</view><view>留下一点属于你们的记录。</view></view>
    <button class="love-btn" bindtap="backHome">开始记录</button>
    <view class="success-landscape"><view>♡</view><text>♡</text></view>
    <view class="hand-note success-note"><view>好的关系</view><view>是一起把平凡的日子</view><view>过成特别的回忆 ♡</view></view>
  </view>
  <view wx:if="{{bindingStatus === 'loading'}}" class="loading-cover">正在准备你们的空间…</view>
  <view wx:if="{{bindingStatus === 'error'}}" class="flow-stage">
    <view class="invite-card"><view class="invite-mark">♡</view><view class="invite-title">暂时连接不上</view><view class="invite-sub">{{errorMessage}}</view><button class="love-btn invite-send" bindtap="retrySession" loading="{{loading}}" disabled="{{loading}}">重新加载</button></view>
  </view>
</view>
