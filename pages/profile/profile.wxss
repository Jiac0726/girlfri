.profile-page {
  padding-bottom: 100rpx;
}

.profile-hero {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx 34rpx;
}

.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 36rpx;
  background: linear-gradient(145deg, #ff6b81, #ff9bad);
  box-shadow: 0 12rpx 30rpx rgba(255, 107, 129, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-avatar text {
  font-size: 52rpx;
  line-height: 1;
}

.profile-hero-copy {
  margin-left: 22rpx;
  min-width: 0;
}

.profile-eyebrow {
  color: #ff6b81;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.profile-title {
  margin-top: 4rpx;
  color: #4a3540;
  font-size: 40rpx;
  font-weight: 800;
}

.profile-sub {
  margin-top: 5rpx;
  color: #a98894;
  font-size: 22rpx;
  line-height: 1.55;
}

.bind-card {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 28rpx;
  padding: var(--card-pad);
  border-radius: var(--card-radius);
  background: linear-gradient(135deg, #ffffff, #ffe9ee);
  border: 2rpx solid #ffd3dc;
}

.bind-card-icon {
  font-size: 44rpx;
  margin-right: 18rpx;
}

.bind-card-body {
  flex: 1;
}

.bind-card-title {
  color: #4a3540;
  font-size: 28rpx;
  font-weight: 800;
}

.bind-card-sub {
  margin-top: 4rpx;
  color: #aa8995;
  font-size: 22rpx;
}

.bind-card-arrow {
  color: #ff6b81;
  font-size: 48rpx;
}

.saved-mood {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #fff8fa, #fff0f4);
}

.saved-mood-emoji {
  width: 72rpx;
  font-size: 46rpx;
  text-align: center;
  flex-shrink: 0;
}

.saved-mood-body {
  margin-left: 16rpx;
  min-width: 0;
}

.saved-mood-text {
  color: #5d4650;
  font-size: 25rpx;
  line-height: 1.55;
  word-break: break-all;
}

.saved-mood-time {
  margin-top: 5rpx;
  color: #bd9ca8;
  font-size: 19rpx;
}

.mood-label {
  color: #775d67;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.mood-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.mood-chip {
  padding: 18rpx 6rpx 14rpx;
  border-radius: 20rpx;
  background: #fffafb;
  border: 2rpx solid #f2e1e6;
  text-align: center;
}

.mood-chip-active {
  background: #ffe6eb;
  border-color: #ff8da0;
  transform: translateY(-2rpx);
}

.mood-chip-emoji {
  font-size: 40rpx;
  line-height: 1.2;
}

.mood-chip-label {
  margin-top: 5rpx;
  color: #8e707b;
  font-size: 19rpx;
}

.mood-chip-active .mood-chip-label {
  color: #ff5f79;
  font-weight: 700;
}

.mood-text-label {
  margin-top: 30rpx;
}

.mood-input {
  width: 100%;
  min-height: 126rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #fffafb;
  border: 2rpx solid #f2e1e6;
  color: #4a3540;
  font-size: 26rpx;
  line-height: 1.65;
}

.mood-count {
  margin-top: 8rpx;
  text-align: right;
  color: #c1a7b0;
  font-size: 20rpx;
}

.mood-save-btn {
  margin-top: 22rpx;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 999rpx;
  background: #ff6b81 !important;
  color: #ffffff !important;
  font-size: 27rpx;
  font-weight: 700;
}

.mood-save-btn[disabled] {
  background: #f0dce2 !important;
  color: #baa2aa !important;
}

.mood-save-btn::after {
  border: none;
}

.partner-section {
  margin-top: 46rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  margin: 0 8rpx 18rpx;
}

.section-title {
  color: #4a3540;
  font-size: 30rpx;
  font-weight: 800;
}

.section-sub {
  margin-top: 3rpx;
  color: #b0919c;
  font-size: 21rpx;
}

.section-heart {
  margin-left: auto;
  color: #ff8ca0;
  font-size: 42rpx;
}

.partner-mood-card {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  padding: var(--card-pad);
  border-radius: var(--card-radius);
  background: linear-gradient(135deg, #ffffff, #fff3f6);
  border: 2rpx solid #ffdae2;
  box-shadow: 0 7rpx 24rpx rgba(255, 107, 129, 0.08);
}

.partner-mood-emoji {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  background: #ffe7ec;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  flex-shrink: 0;
}

.partner-mood-body {
  margin-left: 24rpx;
  min-width: 0;
}

.partner-mood-text {
  color: #4f3c44;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.65;
  word-break: break-all;
}

.partner-mood-time {
  margin-top: 8rpx;
  color: #b99da7;
  font-size: 20rpx;
}

.partner-empty {
  width: 100%;
  box-sizing: border-box;
  padding: 54rpx var(--card-pad);
  border-radius: var(--card-radius);
  background: rgba(255, 255, 255, 0.62);
  text-align: center;
}

.partner-empty-icon {
  font-size: 50rpx;
}

.partner-empty-title {
  margin-top: 8rpx;
  color: #7c626c;
  font-size: 25rpx;
  font-weight: 700;
}

.partner-empty-sub {
  margin-top: 4rpx;
  color: #b99fa8;
  font-size: 21rpx;
}

.profile-footnote {
  margin: 38rpx 18rpx 0;
  color: #b79da6;
  font-size: 21rpx;
  line-height: 1.7;
  text-align: center;
}



.miss-notify-card {
  margin-top: 34rpx;
  background: linear-gradient(145deg, #fffdfd, #fff4f7);
}
.miss-notify-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}
.miss-notify-head > view:first-child {
  flex: 1;
  min-width: 0;
}
.miss-notify-sub {
  margin-top: 6rpx;
  color: #aa8995;
  font-size: 22rpx;
  line-height: 1.55;
}
.miss-notify-badge {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f8e6ec;
  color: #a64d68;
  font-size: 19rpx;
  line-height: 1.4;
}
.miss-notify-status {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  color: #9f828d;
  font-size: 21rpx;
}
.miss-notify-status .reminder-dot.active {
  background: #ff6b81;
  box-shadow: 0 0 0 7rpx rgba(255, 107, 129, 0.12);
}
.miss-notify-button {
  width: 100%;
  height: 82rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: #9f415d;
  color: #fff8fa;
  font-size: 24rpx;
  line-height: 82rpx;
}
.miss-notify-button::after {
  border: 0;
}
.miss-notify-button[disabled] {
  background: #ead9df;
  color: #b99fa8;
}

.reminder-card {
  margin-top: 34rpx;
}

.reminder-head {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.reminder-head > view:first-child {
  flex: 1;
  min-width: 0;
}

.reminder-sub {
  margin-top: 6rpx;
  color: #aa8995;
  font-size: 22rpx;
  line-height: 1.55;
}

.reminder-row {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 22rpx 0;
  border-top: 2rpx solid #f5e6ea;
  border-bottom: 2rpx solid #f5e6ea;
}

.reminder-row-copy {
  flex: 1;
  min-width: 0;
}

.reminder-row-title {
  color: #5d4650;
  font-size: 26rpx;
  font-weight: 700;
}

.reminder-row-sub {
  margin-top: 4rpx;
  color: #b0919c;
  font-size: 20rpx;
}

.reminder-time {
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: #fff3f6;
  color: #e85c74;
  font-size: 25rpx;
  font-weight: 700;
}

.reminder-status {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  color: #a48a94;
  font-size: 21rpx;
  line-height: 1.5;
}

.reminder-status.on {
  color: #d8556d;
}

.reminder-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #d7c6cc;
  flex-shrink: 0;
}

.reminder-status.on .reminder-dot {
  background: #ff6b81;
  box-shadow: 0 0 0 7rpx rgba(255, 107, 129, 0.12);
}

.reminder-note {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff8fa;
  color: #b0919c;
  font-size: 20rpx;
  line-height: 1.65;
}
.our-links{display:flex;align-items:stretch;gap:20rpx;margin:28rpx 0}.our-link{position:relative;display:flex;flex-direction:column;flex:1;min-width:0;min-height:210rpx;box-sizing:border-box;padding:var(--card-pad) 22rpx 85rpx;border-radius:var(--card-radius);color:#814c68}.our-link view{font-size:32rpx;font-weight:600}.our-link text{display:block;font-size:22rpx;margin-top:14rpx;line-height:1.6}.agreements-link{background:linear-gradient(135deg,#fde5ed,#f8cfe4)}.coupons-link{background:linear-gradient(135deg,#eee5fe,#ded0f8)}.our-link .our-link-icon{position:absolute;bottom:8rpx;right:24rpx;font-size:62rpx;color:#ffffffb3}

.private-memo-card{margin-top:8rpx;background:linear-gradient(145deg,#fffdfd,#fff5f7)}
.private-memo-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}
.private-memo-head .card-title{margin-bottom:6rpx}
.private-memo-sub{color:#a18690;font-size:21rpx;line-height:1.6}
.private-memo-lock{flex-shrink:0;padding:7rpx 14rpx;border-radius:999rpx;background:#f4e9ed;color:#8c6e79;font-size:19rpx;line-height:1.4}
.memo-editor{margin-top:24rpx;padding:22rpx;border:1rpx solid #eedce2;border-radius:22rpx;background:#fffafb}
.memo-title-input{width:100%;height:76rpx;box-sizing:border-box;padding:0 18rpx;border-radius:16rpx;background:#fff;color:#503c45;font-size:25rpx}
.private-memo-input{width:100%;min-height:170rpx;margin-top:14rpx;padding:18rpx;box-sizing:border-box;border-radius:16rpx;background:#fff;color:#4f3b44;font-size:25rpx;line-height:1.75}
.memo-draft-images{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx;margin-top:16rpx}
.memo-draft-image{position:relative;height:150rpx;overflow:hidden;border-radius:14rpx;background:#f6e9ed}
.memo-draft-image image{width:100%;height:100%;display:block}
.memo-draft-image button{position:absolute;top:6rpx;right:6rpx;width:42rpx;height:42rpx;margin:0;padding:0;border-radius:50%;background:rgba(62,43,51,.72);color:#fff;font-size:24rpx;line-height:42rpx}
.memo-draft-image button::after{border:0}
.memo-add-photo{width:100%;height:72rpx;margin-top:16rpx;border:1rpx dashed #ddb7c4;border-radius:16rpx;background:#fff6f8;color:#a84f6a;font-size:23rpx;line-height:72rpx}
.memo-add-photo::after{border:0}
.memo-add-photo[disabled]{background:#faf4f6;color:#c6adb5}
.private-memo-meta{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:12rpx;color:#b49aa3;font-size:19rpx}
.memo-editor-actions{display:flex;gap:12rpx;margin-top:18rpx}
.private-memo-save,.memo-cancel{height:78rpx;margin:0;border-radius:999rpx;font-size:24rpx;line-height:78rpx}
.private-memo-save{flex:1;background:#8f4960;color:#fff;font-weight:600}
.memo-cancel{width:170rpx;background:#f2e6ea;color:#8b6874}
.private-memo-save::after,.memo-cancel::after{border:0}
.private-memo-save[disabled],.memo-cancel[disabled]{background:#eadce1;color:#b99fa8}
.memo-list-head{display:flex;align-items:center;justify-content:space-between;margin-top:30rpx;padding:0 4rpx 14rpx;color:#674a56;font-size:24rpx;font-weight:700}
.memo-list-head text:last-child{color:#b399a3;font-size:19rpx;font-weight:400}
.memo-empty{padding:28rpx 18rpx;border-radius:18rpx;background:#fff8fa;color:#ad909a;font-size:22rpx;line-height:1.7;text-align:center}
.memo-item{margin-top:14rpx;padding:22rpx;border:1rpx solid #efdee4;border-radius:20rpx;background:#fff}
.memo-item-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}
.memo-item-title{min-width:0;color:#523c46;font-size:26rpx;font-weight:700;word-break:break-all}
.memo-item-date{flex-shrink:0;color:#b39aa3;font-size:18rpx}
.memo-item-text{margin-top:12rpx;color:#6a515b;font-size:24rpx;line-height:1.75;white-space:pre-wrap;word-break:break-word}
.memo-item-images{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8rpx;margin-top:16rpx}
.memo-item-images.single{grid-template-columns:minmax(0,1fr)}
.memo-item-image{height:150rpx;overflow:hidden;border-radius:12rpx;background:#f6eaee}
.memo-item-images.single .memo-item-image{height:300rpx}
.memo-item-image image{width:100%;height:100%;display:block}
.memo-item-actions{display:flex;justify-content:flex-end;gap:20rpx;margin-top:16rpx;padding-top:14rpx;border-top:1rpx solid #f3e8eb}
.memo-action{margin:0;padding:4rpx 0;background:transparent;color:#a84f6a;font-size:22rpx;line-height:1.6}
.memo-action.delete{color:#9f7d88}
.memo-action::after{border:0}

